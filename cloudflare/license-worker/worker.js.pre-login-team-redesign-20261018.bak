    const rawToken = String(body.token || ""), flow = String(body.flow || ""), password = String(body.password || "");
    if (!/^[a-f0-9]{64}$/i.test(rawToken) || !["invite", "reset"].includes(flow) || password.length < 10 || password.length > 512) return json({ error: "Gebruik een wachtwoord van minimaal 10 tekens en maximaal 512 tekens." }, 400);
    const purpose = flow === "invite" ? "invite" : "password_reset", now = Date.now();
    const tokenRow = await env.DB.prepare("SELECT t.customer_account_id, a.active, c.status AS customer_status, cp.enabled AS product_enabled, p.active AS product_active FROM customer_auth_tokens t JOIN customer_portal_accounts a ON a.id = t.customer_account_id JOIN customers c ON c.id = a.customer_id JOIN customer_products cp ON cp.customer_id = c.id AND cp.product_id = 'eventhub' JOIN products p ON p.id = cp.product_id WHERE t.token_hash = ? AND t.purpose = ? AND t.consumed_at IS NULL AND t.expires_at > ? AND a.disabled_at IS NULL LIMIT 1").bind(await digest(rawToken), purpose, now).first();
