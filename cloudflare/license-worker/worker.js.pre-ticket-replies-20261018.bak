        env.DB.prepare("INSERT INTO customer_products (customer_id, product_id, max_licenses, allowed_license_types, enabled) VALUES (?, 'eventhub', ?, ?, 1)").bind(id, maxLicenses, JSON.stringify(licenseTypes))
      ]);
      return json({ customer: { id, name, contact_name: contactName, contact_email: contactEmail, notes, status: "active", product_id: "eventhub", max_licenses: maxLicenses, allowed_license_types: licenseTypes, product_enabled: 1, licenses_in_use: 0 } }, 201);
