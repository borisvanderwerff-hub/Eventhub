    const ownerOnly = () => actor.role === "owner";
    if (request.method === "GET" && url.pathname === "/api/admin/me") return json({ id: actor.id || null, role: actor.role, name: actor.name, first_name: actor.first_name, permissions: actor.permissions, functions: actor.functions });
    if (request.method === "PATCH" && url.pathname === "/api/admin/me") {
      let body;
      try { body = await readJson(request); } catch { return json({ error: "Ongeldige aanvraag." }, 400); }
      const firstName = String(body.first_name || "").trim().replace(/\s+/g, " ").slice(0, 40);
      const displayName = String(body.name || "").trim().replace(/\s+/g, " ").slice(0, 80);
      if (!firstName || !displayName) return json({ error: "Vul zowel je volledige naam als je voornaam in." }, 400);
      if (actor.id) await env.DB.prepare("UPDATE staff_access_tokens SET name = ?, first_name = ? WHERE id = ? AND revoked_at IS NULL").bind(displayName, firstName, actor.id).run();
      else await env.DB.prepare("UPDATE owner_mfa SET name = ?, first_name = ? WHERE id = 1").bind(displayName, firstName).run();
      return json({ name: displayName, first_name: firstName });
