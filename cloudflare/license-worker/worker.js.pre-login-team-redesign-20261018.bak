import { connect } from "cloudflare:sockets";

const SUPPORT_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cohentra | Support</title><style>
:root{color-scheme:light;--ink:#17283a;--muted:#66788b;--line:#dce5ec;--blue:#1768a6;--pale:#f3f7fa;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#f1f5f8;color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}.top{background:linear-gradient(120deg,#102c44,#1768a6);color:white;padding:22px max(22px,calc((100vw - 1200px)/2));display:flex;justify-content:space-between;align-items:center}.brand{font-size:22px;font-weight:800;letter-spacing:.12em}.brand span{font-weight:400;letter-spacing:.03em}.top p{margin:3px 0 0;color:#d2e5f3}.wrap{max-width:1200px;margin:30px auto;padding:0 20px}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:22px;margin:16px 0;box-shadow:0 3px 14px #16314c0b}h1{font-size:25px;margin:0}h2{font-size:19px;margin:0 0 12px}.muted{color:var(--muted)}label{display:block;font-weight:600;margin:12px 0 5px}input{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px}button,select{font:inherit;border:0;border-radius:7px;padding:9px 12px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e5edf4;color:var(--ink)}select{background:white;color:var(--ink);border:1px solid #bdcbd8}.actions{display:flex;gap:9px;align-items:center;margin-top:14px}.error{color:var(--red);margin-top:8px}.hidden{display:none!important}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:950px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:10px;vertical-align:top}th{font-size:13px;color:var(--muted)}.status-cell{display:flex;gap:6px}.message{white-space:pre-wrap;overflow-wrap:anywhere;max-width:480px;font-size:14px}.split{display:flex;justify-content:space-between;align-items:center;gap:12px}.icon-button{width:38px;height:38px;padding:0;border-radius:50%;background:#ffffff20;color:white;font-size:21px}.icon-button:hover{background:#ffffff35}.dialog{width:min(440px,calc(100% - 28px));border:1px solid var(--line);border-radius:12px;padding:24px;box-shadow:0 18px 60px #102c4440}.dialog::backdrop{background:#102c4470}.dialog-head{display:flex;justify-content:space-between;align-items:center}.close-button{background:transparent;color:var(--muted);font-size:24px;padding:0 6px}.dialog input{display:block}@media(max-width:600px){.wrap{padding:0 12px}.card{padding:16px}.top{padding:16px 18px}}
</style></head><body><header class="top"><div><div class="brand">COHENTRA <span>digital</span></div><p>Support inbox</p></div><button id="settingsButton" class="icon-button hidden" type="button" aria-label="Instellingen" title="Instellingen">⚙</button></header><main class="wrap">
<section id="login" class="card" style="max-width:460px;margin:46px auto"><h1>Support aanmelden</h1><p class="muted">Gebruik je Cohentra-supportaccount en authenticatorcode.</p><form id="credentialsForm"><label for="username">Gebruikersnaam</label><input id="username" autocomplete="username" required><label for="password">Wachtwoord</label><input id="password" type="password" autocomplete="current-password" required><div class="actions"><button id="loginButton">Verder</button></div><div id="loginError" class="error" role="alert"></div></form><form id="mfaForm" class="hidden"><label for="mfaCode">Authenticator- of herstelcode</label><input id="mfaCode" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" required><div class="actions"><button id="verifyButton">Aanmelden</button><button type="button" class="secondary" id="backButton">Terug</button></div><div id="mfaError" class="error" role="alert"></div></form></section>
<section id="firstPassword" class="card hidden" style="max-width:460px;margin:46px auto"><h1>Tijdelijk wachtwoord vervangen</h1><p class="muted">Kies een eigen wachtwoord om verder te gaan naar de supportinbox.</p><form id="firstPasswordForm"><label for="firstNewPassword">Nieuw wachtwoord</label><input id="firstNewPassword" type="password" autocomplete="new-password" required><label for="firstConfirmPassword">Herhaal nieuw wachtwoord</label><input id="firstConfirmPassword" type="password" autocomplete="new-password" required><div class="actions"><button id="firstPasswordButton">Wachtwoord opslaan</button></div><div id="firstPasswordError" class="error" role="alert"></div></form></section>
<section id="dashboard" class="hidden"><section class="card"><div class="split"><div><h1>Supportaanvragen</h1><p class="muted">Tickets van klanten in Cohentra.</p></div><button class="secondary" id="logout">Afmelden</button></div></section><section class="card"><div class="split"><h2>Inbox</h2><button class="secondary" id="refresh">Vernieuwen</button></div><div class="table-wrap"><table><thead><tr><th>Referentie</th><th>Klant</th><th>Onderwerp / bericht</th><th>Categorie</th><th>Aangemaakt</th><th>Status</th></tr></thead><tbody id="tickets"><tr><td colspan="6" class="muted">Laden…</td></tr></tbody></table></div><div id="ticketError" class="error" role="alert"></div></section></section></main>
<dialog id="settingsDialog" class="dialog"><div class="dialog-head"><h2>Instellingen</h2><button class="close-button" id="closeSettings" type="button" aria-label="Sluiten">×</button></div><section><h3>Profiel</h3><p class="muted">Stel je naam in. Je voornaam wordt gebruikt in de afsluiting van supportmails.</p><form id="profileForm"><label for="profileName">Volledige naam</label><input id="profileName" maxlength="80" autocomplete="name" required><label for="profileFirstName">Voornaam in e-mailhandtekening</label><input id="profileFirstName" maxlength="40" autocomplete="given-name" required><div class="actions"><button id="profileButton">Profiel opslaan</button></div><div id="profileMessage" class="error" role="status"></div></form></section><hr><p class="muted">Wijzig ook hier je wachtwoord.</p><form id="passwordForm"><label for="currentPassword">Huidig wachtwoord</label><input id="currentPassword" type="password" autocomplete="current-password" required><label for="newPassword">Nieuw wachtwoord</label><input id="newPassword" type="password" autocomplete="new-password" required><label for="confirmPassword">Herhaal nieuw wachtwoord</label><input id="confirmPassword" type="password" autocomplete="new-password" required><div class="actions"><button id="passwordButton">Wachtwoord wijzigen</button><button class="secondary" id="cancelSettings" type="button">Annuleren</button></div><div id="passwordMessage" class="error" role="status"></div></form></dialog>
<script>
const $=id=>document.getElementById(id);let token=sessionStorage.getItem('cohentra-support-token')||'',challenge='',passwordChangeToken='';function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function showLogin(message=''){$('login').classList.remove('hidden');$('firstPassword').classList.add('hidden');$('dashboard').classList.add('hidden');$('settingsButton').classList.add('hidden');$('credentialsForm').classList.remove('hidden');$('mfaForm').classList.add('hidden');$('loginError').textContent=message}function headers(value=token){return {'Authorization':'Bearer '+value,'Content-Type':'application/json'}}async function api(path,options={}){const r=await fetch(path,{...options,headers:{...headers(),...(options.headers||{})}});let d={};try{d=await r.json()}catch{}if(r.status===401){token='';sessionStorage.removeItem('cohentra-support-token');showLogin('Je sessie is verlopen. Meld opnieuw aan.')}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}const statuses={new:'Nieuw',in_progress:'In behandeling',waiting_customer:'Wacht op klant',closed:'Afgerond'};function category(v,source,requestType){if(source==='website'){const names={maatwerksoftware:'Software op maat',procesautomatisering:'Procesautomatisering',website:'Website op maat',overig:'Verkennend gesprek'};return 'Websiteformulier · '+(names[requestType]||'Aanvraag')}return ({eventhub:'EventHub gebruiken',license:'Licentie',account:'Account / toegang',other:'Anders'})[v]||v}async function loadTickets(){const d=await api('/api/support/tickets');$('tickets').innerHTML=d.tickets.length?d.tickets.map(t=>'<tr><td><strong>'+safe(t.reference)+'</strong></td><td>'+safe(t.customer_name)+(t.source==='website'&&t.organization?'<br><span class="muted">'+safe(t.organization)+'</span>':'')+'<br><a href="mailto:'+encodeURIComponent(t.contact_email||'')+'">'+safe(t.contact_email||'Geen e-mailadres')+'</a></td><td><strong>'+safe(t.subject)+'</strong><div class="message">'+safe(t.message)+'</div></td><td>'+safe(category(t.category,t.source,t.request_type))+'</td><td>'+safe(new Date(t.created_at).toLocaleString('nl-NL'))+'</td><td><div class="status-cell"><select data-status="'+safe(t.id)+'">'+Object.entries(statuses).map(([k,v])=>'<option value="'+k+'" '+(t.status===k?'selected':'')+'>'+v+'</option>').join('')+'</select><button data-save="'+safe(t.id)+'">Opslaan</button></div></td></tr>').join(''):'<tr><td colspan="6" class="muted">Er zijn nog geen supportaanvragen.</td></tr>'}async function enter(){const [me]=await Promise.all([api('/api/admin/me'),loadTickets()]);$('profileName').value=me.name||'';$('profileFirstName').value=me.first_name||'';$('login').classList.add('hidden');$('firstPassword').classList.add('hidden');$('dashboard').classList.remove('hidden');$('settingsButton').classList.remove('hidden')}async function responseJson(r){let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}
$('credentialsForm').onsubmit=async e=>{e.preventDefault();$('loginButton').disabled=true;$('loginError').textContent='';try{const d=await responseJson(await fetch('/api/auth/challenge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('username').value.trim(),password:$('password').value})}));if(!d.challenge_token)throw Error('Aanmelden met MFA is vereist.');challenge=d.challenge_token;$('credentialsForm').classList.add('hidden');$('mfaForm').classList.remove('hidden');$('mfaCode').focus()}catch(err){$('loginError').textContent=err.message}finally{$('loginButton').disabled=false}};
$('mfaForm').onsubmit=async e=>{e.preventDefault();$('verifyButton').disabled=true;$('mfaError').textContent='';try{const code=$('mfaCode').value.trim().replace(/[\s-]/g,'');const body={challenge_token:challenge,mfa_code:/^\d{6}$/.test(code)?code:'',recovery_code:/^\d{6}$/.test(code)?'':$('mfaCode').value.trim()};const d=await responseJson(await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}));if(d.password_change_required){passwordChangeToken=d.password_change_token;$('login').classList.add('hidden');$('firstPassword').classList.remove('hidden');$('firstNewPassword').focus();return}token=d.session_token;sessionStorage.setItem('cohentra-support-token',token);await enter()}catch(err){$('mfaError').textContent=err.message}finally{$('verifyButton').disabled=false}};
$('firstPasswordForm').onsubmit=async e=>{e.preventDefault();$('firstPasswordButton').disabled=true;$('firstPasswordError').textContent='';try{const d=await responseJson(await fetch('/api/auth/password/first-change',{method:'POST',headers:headers(passwordChangeToken),body:JSON.stringify({new_password:$('firstNewPassword').value,confirm_password:$('firstConfirmPassword').value})}));token=d.session_token;sessionStorage.setItem('cohentra-support-token',token);passwordChangeToken='';$('firstPasswordForm').reset();await enter()}catch(err){$('firstPasswordError').textContent=err.message}finally{$('firstPasswordButton').disabled=false}};
$('backButton').onclick=()=>{challenge='';$('mfaCode').value='';showLogin()};$('tickets').onclick=async e=>{const id=e.target.dataset.save;if(!id)return;const status=$('tickets').querySelector('[data-status="'+CSS.escape(id)+'"]').value;e.target.disabled=true;$('ticketError').textContent='';try{await api('/api/support/tickets/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify({status})});await loadTickets()}catch(err){$('ticketError').textContent=err.message}finally{e.target.disabled=false}};$('refresh').onclick=()=>loadTickets().catch(e=>$('ticketError').textContent=e.message);$('settingsButton').onclick=()=>{$('passwordForm').reset();$('passwordMessage').textContent='';$('profileMessage').textContent='';$('settingsDialog').showModal()};$('closeSettings').onclick=$('cancelSettings').onclick=()=>$('settingsDialog').close();$('settingsDialog').onclick=e=>{if(e.target===$('settingsDialog'))$('settingsDialog').close()};$('profileForm').onsubmit=async e=>{e.preventDefault();$('profileButton').disabled=true;$('profileMessage').textContent='';try{const d=await api('/api/admin/me',{method:'PATCH',body:JSON.stringify({name:$('profileName').value.trim(),first_name:$('profileFirstName').value.trim()})});$('profileName').value=d.name;$('profileFirstName').value=d.first_name;$('profileMessage').textContent='Profiel opgeslagen.'}catch(err){$('profileMessage').textContent=err.message}finally{$('profileButton').disabled=false}};$('passwordForm').onsubmit=async e=>{e.preventDefault();$('passwordButton').disabled=true;$('passwordMessage').textContent='';try{await api('/api/support/account/password',{method:'POST',body:JSON.stringify({current_password:$('currentPassword').value,new_password:$('newPassword').value,confirm_password:$('confirmPassword').value})});$('passwordForm').reset();$('passwordMessage').textContent='Wachtwoord gewijzigd.';setTimeout(()=>$('settingsDialog').close(),800)}catch(err){$('passwordMessage').textContent=err.message}finally{$('passwordButton').disabled=false}};$('logout').onclick=async()=>{token='';sessionStorage.removeItem('cohentra-support-token');showLogin()};if(token)enter().catch(e=>showLogin(e.message));else showLogin();
</script></body></html>`;

const CUSTOMER_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cohentra | Klantenportaal</title>
<style>
:root{color-scheme:light;--ink:#17283a;--muted:#66788b;--line:#dce5ec;--blue:#1768a6;--navy:#12324b;--pale:#f3f7fa;--green:#e9f6ed;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#f1f5f8;color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}.top{background:linear-gradient(120deg,#102c44,#1768a6);color:white;padding:25px max(22px,calc((100vw - 1080px)/2))}.brand{font-size:23px;font-weight:800;letter-spacing:.12em}.brand span{font-weight:400;letter-spacing:.03em}.top p{margin:3px 0 0;color:#d2e5f3}.wrap{max-width:1080px;margin:34px auto;padding:0 20px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:24px;margin:16px 0;box-shadow:0 5px 20px #1831480a}h1{font-size:25px;margin:0 0 5px}h2{font-size:19px;margin:0 0 10px}.muted{color:var(--muted)}label{display:block;font-weight:650;margin:13px 0 5px}input,select,textarea{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px;background:#fff}textarea{width:100%;min-height:140px;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px;font:inherit;resize:vertical}button{font:inherit;border:0;border-radius:7px;padding:10px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e8eff5;color:var(--ink)}button.danger{background:#fff0ef;color:var(--red);padding:7px 10px}.actions{display:flex;gap:10px;align-items:center;margin-top:15px}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{background:var(--pale);border-radius:9px;padding:15px}.stat strong{display:block;font-size:23px}.stat span{font-size:13px;color:var(--muted)}.error{color:var(--red);margin-top:9px}.notice{background:var(--green);border:1px solid #c8e2ce;border-radius:8px;padding:14px;margin:13px 0;overflow-wrap:anywhere}.hidden{display:none!important}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:650px}th,td{text-align:left;padding:11px 8px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:13px}.key{font:700 16px ui-monospace,monospace;word-break:break-all}.split{display:flex;justify-content:space-between;align-items:center;gap:12px}@media(max-width:650px){.wrap{margin:20px auto}.row,.grid{grid-template-columns:1fr}.card{padding:18px}.top{padding:20px}}
</style></head><body><header class="top"><div class="brand">COHENTRA <span>digital</span></div><p>Klantenportaal · EventHub</p></header><main class="wrap">
<section id="login" class="card" style="max-width:460px;margin:48px auto"><h1>Aanmelden</h1><p class="muted">Beheer je EventHub-licenties veilig op één plek.</p><form id="loginForm"><label for="username">Gebruikersnaam</label><input id="username" autocomplete="username" required><label for="password">Wachtwoord</label><input id="password" type="password" autocomplete="current-password" required><div class="actions"><button id="loginButton">Aanmelden</button><button id="forgotButton" type="button" class="secondary">Wachtwoord vergeten?</button></div><div id="loginError" class="error" role="alert"></div></form><p class="muted">Hulp nodig bij aanmelden? <a href="mailto:info@cohentra.digital?subject=Hulp%20bij%20aanmelden%20EventHub">Mail Cohentra</a>.</p></section>
<section id="forgotPanel" class="card hidden" style="max-width:460px;margin:48px auto"><h1>Wachtwoord herstellen</h1><p class="muted">Vul het e-mailadres in dat bij je klantaccount hoort. Als er een account is, sturen we een beveiligde link.</p><form id="forgotForm"><label for="forgotEmail">E-mailadres</label><input id="forgotEmail" type="email" autocomplete="email" required><div class="actions"><button id="forgotSubmit">Herstellink sturen</button><button type="button" id="backToLogin" class="secondary">Terug</button></div><div id="forgotMessage" role="status"></div></form></section>
<section id="tokenPanel" class="card hidden" style="max-width:460px;margin:48px auto"><h1 id="tokenTitle">Wachtwoord instellen</h1><p class="muted">Kies een wachtwoord voor je bestaande klantenportaalaccount.</p><form id="tokenForm"><label for="tokenPassword">Nieuw wachtwoord</label><input id="tokenPassword" type="password" autocomplete="new-password" required><label for="tokenPasswordConfirm">Herhaal wachtwoord</label><input id="tokenPasswordConfirm" type="password" autocomplete="new-password" required><div class="actions"><button id="tokenSubmit">Wachtwoord opslaan</button></div><div id="tokenMessage" class="error" role="alert"></div></form></section>
<div id="dashboard" class="hidden"><section class="card"><div class="split"><div><h1 id="welcome">Klantenportaal</h1><p class="muted">Beheer zelf de EventHub-licenties die bij jouw klantaccount horen.</p></div><button class="secondary" id="logout">Afmelden</button></div><div class="grid"><div class="stat"><strong id="used">—</strong><span>Licenties in gebruik</span></div><div class="stat"><strong id="limit">—</strong><span>Maximaal toegestaan</span></div><div class="stat"><strong id="types">—</strong><span>Toegestane typen</span></div></div></section>
<section class="card"><h2>Licentie aanmaken</h2><form id="createForm"><div class="row"><div><label for="label">Naam / gebruiker (optioneel)</label><input id="label" maxlength="80" placeholder="Bijvoorbeeld Testgebruiker"></div><div><label for="type">Licentietype</label><select id="type"></select></div></div><div class="row" id="dates"><div><label for="validFrom">Geldig vanaf</label><input id="validFrom" type="date" required></div><div><label for="validUntil">Geldig tot en met</label><input id="validUntil" type="date" required></div></div><div class="actions"><button id="createButton">Licentie aanmaken</button></div><div id="createError" class="error" role="alert"></div><div id="createdKey" class="notice hidden"><strong>Bewaar deze sleutel; hij wordt hierna niet opnieuw getoond.</strong><p class="key" id="keyValue"></p><button type="button" class="secondary" id="copyKey">Kopieer sleutel</button></div></form></section>
<section class="card"><div class="split"><h2>Mijn licenties</h2><button class="secondary" id="refresh">Vernieuwen</button></div><div class="table-wrap"><table><thead><tr><th>Naam</th><th>Type</th><th>Geldig vanaf</th><th>Geldig tot</th><th>Status</th><th></th></tr></thead><tbody id="licenses"><tr><td colspan="6" class="muted">Laden…</td></tr></tbody></table></div></section>
<section class="card"><h2>Supportaanvraag indienen</h2><p class="muted">Omschrijf je vraag. Stuur geen wachtwoorden of volledige licentiesleutels mee.</p><form id="ticketForm"><div class="row"><div><label for="ticketCategory">Onderwerp</label><select id="ticketCategory"><option value="eventhub">EventHub gebruiken</option><option value="license">Licentie</option><option value="account">Account / toegang</option><option value="other">Anders</option></select></div><div><label for="ticketSubject">Korte omschrijving</label><input id="ticketSubject" maxlength="120" required></div></div><label for="ticketMessage">Waar kunnen we mee helpen?</label><textarea id="ticketMessage" maxlength="6000" required></textarea><div class="actions"><button id="ticketButton">Supportaanvraag versturen</button></div><div id="ticketError" class="error" role="alert"></div><div id="ticketCreated" class="notice hidden" role="status"></div></form><h2 style="margin-top:24px">Mijn supportaanvragen</h2><div class="table-wrap"><table><thead><tr><th>Referentienummer</th><th>Onderwerp</th><th>Datum</th><th>Status</th></tr></thead><tbody id="myTickets"><tr><td colspan="4" class="muted">Laden…</td></tr></tbody></table></div><p class="muted">Liever e-mailen? <a href="mailto:support@cohentra.digital?subject=EventHub%20supportverzoek">support@cohentra.digital</a></p></section>
<section class="card"><h2>Wachtwoord wijzigen</h2><form id="passwordForm"><div class="row"><div><label for="oldPassword">Huidig wachtwoord</label><input id="oldPassword" type="password" autocomplete="current-password" required></div><div><label for="newPassword">Nieuw wachtwoord</label><input id="newPassword" type="password" autocomplete="new-password" required></div></div><div class="actions"><button class="secondary">Wachtwoord wijzigen</button></div><div id="passwordMessage" class="error" role="status"></div></form></section></div></main>
<script>
const $=id=>document.getElementById(id);let token=sessionStorage.getItem('cohentra-customer-token')||'',customer={};function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function headers(){return {'Authorization':'Bearer '+token,'Content-Type':'application/json'}}async function api(path,options={}){const r=await fetch(path,{...options,headers:{...headers(),...(options.headers||{})}});let d={};try{d=await r.json()}catch{}if(r.status===401){token='';sessionStorage.removeItem('cohentra-customer-token');if(!$('login').classList.contains('hidden')){}else showLogin('Je sessie is verlopen. Meld opnieuw aan.')}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}function showLogin(error=''){$('login').classList.remove('hidden');$('dashboard').classList.add('hidden');$('loginError').textContent=error}function dateToday(){return new Date().toISOString().slice(0,10)}async function load(){const [me,list]=await Promise.all([api('/api/customer/me'),api('/api/customer/licenses')]);customer=me.customer;$('welcome').textContent='Welkom, '+customer.name;$('used').textContent=customer.licenses_in_use;$('limit').textContent=customer.max_licenses;$('types').textContent=customer.allowed_license_types.map(x=>x==='admin'?'Beheerder':'Gesloten beta').join(', ');$('type').innerHTML=customer.allowed_license_types.map(x=>'<option value="'+safe(x)+'">'+(x==='admin'?'Beheerder':'Gesloten beta')+'</option>').join('');$('dates').classList.toggle('hidden',customer.allowed_license_types.length===1&&customer.allowed_license_types[0]==='admin');$('validFrom').value=dateToday();$('validUntil').value=dateToday();$('licenses').innerHTML=list.licenses.length?list.licenses.map(x=>'<tr><td>'+safe(x.label||'—')+'</td><td>'+safe(x.license_type)+'</td><td>'+safe(x.valid_from)+'</td><td>'+safe(x.valid_until)+'</td><td>'+safe(x.status)+'</td><td>'+(x.revoked_at?'':'<button class="danger" data-revoke="'+safe(x.id)+'">Intrekken</button>')+'</td></tr>').join(''):'<tr><td colspan="6" class="muted">Er zijn nog geen licenties.</td></tr>';await loadTickets();if($('type').value==='admin')$('dates').classList.add('hidden');$('dashboard').classList.remove('hidden');$('login').classList.add('hidden')}async function loadTickets(){const d=await api('/api/customer/tickets');$('myTickets').innerHTML=d.tickets.length?d.tickets.map(t=>'<tr><td><strong>'+safe(t.reference)+'</strong></td><td>'+safe(t.subject)+'</td><td>'+safe(new Date(t.created_at).toLocaleString('nl-NL'))+'</td><td>'+safe(ticketStatusLabel(t.status))+'</td></tr>').join(''):'<tr><td colspan="4" class="muted">Je hebt nog geen supportaanvragen.</td></tr>'}function ticketStatusLabel(s){return ({new:'Nieuw',in_progress:'In behandeling',waiting_customer:'Wacht op jou',closed:'Afgerond'})[s]||s}
$('type').onchange=()=>{$('dates').classList.toggle('hidden',$('type').value==='admin')};$('loginForm').onsubmit=async e=>{e.preventDefault();const b=$('loginButton');b.disabled=true;$('loginError').textContent='';try{const d=await fetch('/api/customer/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('username').value.trim(),password:$('password').value})});const result=await d.json();if(!d.ok)throw Error(result.error||'Aanmelden mislukt.');token=result.session_token;sessionStorage.setItem('cohentra-customer-token',token);await load()}catch(err){$('loginError').textContent=err.message}finally{b.disabled=false}};$('forgotButton').onclick=()=>{ $('login').classList.add('hidden');$('forgotPanel').classList.remove('hidden');$('forgotEmail').value=$('username').value.includes('@')?$('username').value:'';$('forgotEmail').focus()};$('backToLogin').onclick=()=>{$('forgotPanel').classList.add('hidden');$('login').classList.remove('hidden')};$('forgotForm').onsubmit=async e=>{e.preventDefault();$('forgotSubmit').disabled=true;$('forgotMessage').textContent='';try{const r=await fetch('/api/customer/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:$('forgotEmail').value.trim()})});const d=await r.json();if(!r.ok)throw Error(d.error||'Versturen is niet gelukt.');$('forgotMessage').textContent=d.message;$('forgotMessage').className='notice'}catch(err){$('forgotMessage').textContent=err.message;$('forgotMessage').className='error'}finally{$('forgotSubmit').disabled=false}};$('tokenForm').onsubmit=async e=>{e.preventDefault();const tokenParam=new URL(location.href).searchParams.get('token'),flow=new URL(location.href).searchParams.get('flow');$('tokenSubmit').disabled=true;$('tokenMessage').textContent='';try{if($('tokenPassword').value!==$('tokenPasswordConfirm').value)throw Error('De wachtwoorden komen niet overeen.');const r=await fetch('/api/customer/auth/complete-email-auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:tokenParam,flow,password:$('tokenPassword').value})});const d=await r.json();if(!r.ok)throw Error(d.error||'De link is verlopen of ongeldig.');history.replaceState({},'',location.pathname);$('tokenPanel').classList.add('hidden');$('login').classList.remove('hidden');$('loginError').textContent='Je wachtwoord is ingesteld. Je kunt nu aanmelden.'}catch(err){$('tokenMessage').textContent=err.message}finally{$('tokenSubmit').disabled=false}};const params=new URL(location.href).searchParams;if(params.get('token')&&['invite','reset'].includes(params.get('flow'))){$('login').classList.add('hidden');$('tokenPanel').classList.remove('hidden');if(params.get('flow')==='reset')$('tokenTitle').textContent='Nieuw wachtwoord kiezen'}$('logout').onclick=async()=>{try{await api('/api/customer/auth/logout',{method:'POST',body:'{}'})}catch{}token='';sessionStorage.removeItem('cohentra-customer-token');showLogin()};$('refresh').onclick=()=>load().catch(e=>showLogin(e.message));$('createForm').onsubmit=async e=>{e.preventDefault();$('createError').textContent='';$('createdKey').classList.add('hidden');$('createButton').disabled=true;try{const d=await api('/api/customer/licenses',{method:'POST',body:JSON.stringify({label:$('label').value.trim(),license_type:$('type').value,valid_from:$('validFrom').value,valid_until:$('validUntil').value})});$('keyValue').textContent=d.license.license_key;$('createdKey').classList.remove('hidden');$('copyKey').onclick=()=>navigator.clipboard.writeText(d.license.license_key);$('label').value='';await load()}catch(err){$('createError').textContent=err.message}finally{$('createButton').disabled=false}};$('ticketForm').onsubmit=async e=>{e.preventDefault();$('ticketError').textContent='';$('ticketCreated').classList.add('hidden');$('ticketButton').disabled=true;try{const d=await api('/api/customer/tickets',{method:'POST',body:JSON.stringify({category:$('ticketCategory').value,subject:$('ticketSubject').value.trim(),message:$('ticketMessage').value.trim()})});$('ticketCreated').innerHTML='Je supportaanvraag is aangemaakt. Bewaar je referentienummer: <strong class="key">'+safe(d.reference)+'</strong>. Je kunt de status hieronder volgen.'+(d.email_sent?' Een melding is ook naar Cohentra Support verstuurd.':' De e-mailmelding kon niet worden verstuurd; je aanvraag staat wel in het portaal. Vermeld het referentienummer als je contact opneemt via support@cohentra.digital.');$('ticketCreated').classList.remove('hidden');$('ticketForm').reset();await loadTickets()}catch(err){$('ticketError').textContent=err.message}finally{$('ticketButton').disabled=false}};$('licenses').onclick=async e=>{const id=e.target.dataset.revoke;if(!id)return;if(!confirm('Deze licentie intrekken? De licentie kan daarna niet meer worden gebruikt.'))return;e.target.disabled=true;try{await api('/api/customer/licenses/'+encodeURIComponent(id)+'/revoke',{method:'POST',body:'{}'});await load()}catch(err){alert(err.message)}finally{e.target.disabled=false}};$('passwordForm').onsubmit=async e=>{e.preventDefault();$('passwordMessage').textContent='';try{const d=await api('/api/customer/account/password',{method:'POST',body:JSON.stringify({old_password:$('oldPassword').value,new_password:$('newPassword').value})});token=d.session_token;sessionStorage.setItem('cohentra-customer-token',token);$('passwordForm').reset();$('passwordMessage').textContent='Wachtwoord gewijzigd.';await load()}catch(err){$('passwordMessage').textContent=err.message}};if(token)load().catch(e=>showLogin(e.message));else showLogin();
</script></body></html>`;

const ADMIN_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cohentra | Medewerkersportaal</title>
<style>
:root{color-scheme:light;--ink:#122337;--muted:#66778a;--line:#dce4eb;--blue:#145da0;--pale:#f3f7fa;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#eef3f7;color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{max-width:960px;margin:40px auto;padding:0 20px}.head{margin-bottom:22px}.head h1{margin:0;font-size:28px}.head p{margin:4px 0;color:var(--muted)}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:22px;margin:16px 0;box-shadow:0 3px 14px #16314c0b}h2{font-size:19px;margin:0 0 14px}label{display:block;font-weight:600;margin:12px 0 5px}input{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px}button{font:inherit;border:0;border-radius:7px;padding:10px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e5edf4;color:var(--ink)}button.danger{background:#fff1f0;color:var(--red);padding:7px 10px}button:disabled{opacity:.6;cursor:wait}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.actions{display:flex;gap:10px;align-items:center;margin-top:16px}.error{color:var(--red);margin-top:8px}.notice{background:#edf7ef;border:1px solid #bfdcc5;border-radius:8px;padding:14px;margin:14px 0;overflow-wrap:anywhere}.key{font:700 18px ui-monospace,monospace;letter-spacing:.04em}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:650px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:10px 8px;vertical-align:middle}th{font-size:13px;color:var(--muted)}.muted{color:var(--muted)}.hidden{display:none!important}.topline{display:flex;justify-content:space-between;align-items:center;gap:12px}@media(max-width:600px){.wrap{margin:22px auto}.row{grid-template-columns:1fr}.card{padding:17px}}
.ticket-subject{background:transparent;color:var(--ink);padding:0;text-align:left;font-weight:750}.ticket-subject:hover{text-decoration:underline}.ticket-dialog{width:min(860px,calc(100% - 28px));max-height:88vh;overflow:auto;border:1px solid var(--line);border-radius:14px;padding:24px;box-shadow:0 18px 60px #102c4440}.ticket-dialog::backdrop{background:#102c4470}.conversation{display:grid;gap:12px;max-height:42vh;overflow:auto;margin:18px 0}.conversation-message{padding:14px 16px;border:1px solid var(--line);border-radius:10px;background:var(--pale)}.support-message{background:#f1f6ff;border-color:#cbdcf5}.conversation-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:13px}.conversation-text{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:8px}.sent-label{color:#18794e;font-size:12px;margin:8px 0 0}.ticket-dialog textarea{font:inherit;width:100%;min-height:130px;resize:vertical;padding:12px;border:1px solid #bdcbd8;border-radius:8px}.ticket-dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}</style><style>.key-table-wrap{max-height:300px;overflow:auto;margin:12px 0}.key-table{min-width:520px;width:100%;table-layout:fixed}.key-table th:first-child{width:150px}.key-table td{overflow-wrap:anywhere}.key-table .key-value{font:600 14px ui-monospace,monospace;word-break:break-all}.key-copy{white-space:nowrap}.actions-menu{position:relative;display:inline-block}.actions-menu summary{list-style:none;cursor:pointer;display:grid;place-items:center;width:34px;height:32px;border:1px solid var(--line);border-radius:7px;font-size:22px;line-height:1}.actions-menu summary::-webkit-details-marker{display:none}.menu-items{position:absolute;right:0;top:calc(100% + 4px);z-index:10;min-width:160px;padding:6px;display:grid;gap:4px;background:white;border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 20px #12233724}.menu-items button{background:transparent;color:var(--ink);text-align:left;padding:8px 10px;font-weight:500;white-space:nowrap}.menu-items button:hover{background:var(--pale)}.menu-items button.menu-danger{color:var(--red)}.license-group{border:1px solid var(--line);border-radius:8px;margin:10px 0;overflow:visible}.license-group>summary{cursor:pointer;padding:12px 14px;font-weight:700;background:var(--pale);border-radius:8px}.license-group[open]>summary{border-radius:8px 8px 0 0}.license-group .table-wrap{padding:0 8px 8px}.license-group table{min-width:820px}.bulk-controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0;padding:12px;background:var(--pale);border:1px solid var(--line);border-radius:8px}.bulk-controls select{font:inherit;width:auto;min-width:180px;padding:9px;border:1px solid #bdcbd8;border-radius:7px;background:white}.license-select{width:18px;height:18px;vertical-align:middle}dialog{width:min(440px,calc(100vw - 32px));border:1px solid var(--line);border-radius:12px;padding:22px;color:var(--ink);box-shadow:0 18px 60px #12233755}dialog::backdrop{background:#10233788}dialog h2{margin:0 0 8px}dialog p{margin:0;color:var(--muted)}dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}</style>
<style>
body{background:#f3f6f9}
.app-wrap{width:100%;max-width:none;margin:0;padding:0}
.app-wrap>.head{width:min(560px,calc(100% - 40px));margin:40px auto 22px}
.app-wrap>#login,.app-wrap>#loginMfa,.app-wrap>#bootstrap,.app-wrap>#mfaSetup{width:min(560px,calc(100% - 40px));margin:16px auto}
.app-shell{display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}
.sidebar{position:sticky;top:0;height:100vh;background:#112439;color:#f4f8fb;padding:25px 15px 18px;display:flex;flex-direction:column;gap:28px}
.brand{display:flex;align-items:center;gap:11px;padding:0 10px}.brand-mark{width:38px;height:38px;display:grid;place-items:center;background:#1b6eae;border-radius:11px;color:white;font-size:20px;font-weight:800}.brand strong,.brand small{display:block}.brand strong{font-size:16px;letter-spacing:.02em}.brand small{font-size:12px;color:#aebdcb;margin-top:1px}
.nav-list{display:grid;gap:5px}.nav-item{display:flex;align-items:center;gap:12px;width:100%;padding:11px 12px;border:1px solid transparent;border-radius:8px;background:transparent;color:#cbd7e2;text-align:left;font-weight:600}.nav-item:hover{background:#1b344b;color:white}.nav-item.active{background:#214969;border-color:#315c7a;color:#fff}.nav-icon{width:20px;text-align:center;font-size:18px;line-height:1}
.sidebar-spacer{flex:1}.sidebar-logout{width:100%;background:transparent;color:#d8e2eb;border:1px solid #354b60;text-align:left}.sidebar-logout:hover{background:#1b344b}
.main-area{width:100%;max-width:1440px;min-width:0;margin:0 auto;padding:40px clamp(22px,4vw,58px) 64px}
.page-heading{margin:0 0 25px}.page-heading h1{margin:3px 0 5px;font-size:32px;line-height:1.2}.page-heading p{margin:0 0 15px;color:var(--muted)}.eyebrow{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.12em}
.overview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.stat-card{background:white;border:1px solid var(--line);border-radius:12px;padding:19px 20px;box-shadow:0 3px 14px #16314c0b}.stat-label{display:block;color:var(--muted);font-size:13px;font-weight:600}.stat-value{display:block;margin-top:7px;font-size:30px;line-height:1.1;font-weight:750;letter-spacing:-.03em}.overview-actions{margin-top:18px}.quick-actions{display:flex;flex-wrap:wrap;gap:10px}.quick-actions button{min-height:42px}
.mobile-topbar{display:none}.mobile-menu-backdrop{display:none;position:fixed;inset:0;z-index:40;padding:0;border:0;border-radius:0;background:#0b1c2db0}.admin-view{min-width:0}
.email-template-layout{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}.email-template-layout>.card{min-width:0}.email-template-layout select,.email-template-layout input[type="text"]{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px;background:white;color:var(--ink)}.email-template-layout textarea{font:inherit;width:100%;min-height:92px;resize:vertical;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px}.email-template-layout input[type="color"]{width:64px;height:42px;padding:4px}.email-template-layout iframe{display:block}
@media(max-width:820px){.app-shell{display:block}.sidebar{position:fixed;inset:0 auto 0 0;z-index:41;width:min(280px,85vw);height:100dvh;transform:translateX(-105%);transition:transform .22s ease;box-shadow:12px 0 36px #07192b2b}.sidebar.sidebar-open{transform:translateX(0)}.mobile-menu-backdrop.open{display:block}.mobile-topbar{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;margin:-24px -16px 24px;padding:12px 16px;background:#fff;border-bottom:1px solid var(--line)}.mobile-topbar strong{font-size:15px}.mobile-topbar span{color:var(--muted);font-size:13px}.mobile-topbar button{padding:8px 11px}.main-area{padding:24px 16px 46px}.overview-grid{grid-template-columns:1fr}.page-heading h1{font-size:28px}}
@media(prefers-reduced-motion:reduce){.sidebar{transition:none}}
</style>
<style>
:root{--ink:#152039;--muted:#73809a;--line:#e2e7f0;--canvas:#f5f7fb;--card:#fff;--navy:#10152a;--purple:#7046f5;--purple2:#9348f6;--cyan:#22bfd8;--green:#138a66;--amber:#a86706;--red:#be4054;--shadow:0 12px 34px #14244b0c}
*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{min-height:100vh;display:grid;grid-template-columns:248px minmax(0,1fr)}.sidebar{background:var(--navy);color:#e9edff;padding:24px 16px;display:flex;flex-direction:column;gap:28px}.brand{display:flex;align-items:center;padding:2px 10px 14px}.brand strong{font-size:22px;letter-spacing:-.6px}.brand strong span{font-weight:400;color:#b6c1df}.brand small{display:block;color:#8793b4;font-size:12px;margin-top:2px}.brandmark{width:40px;height:40px;margin-right:11px;border-radius:13px;background:linear-gradient(135deg,#7347ff,#2cc7e5);display:grid;place-items:center;color:#fff;font-weight:900;font-size:23px;box-shadow:0 5px 18px #7046f566}.group-label{padding:0 12px;color:#7884a6;font-size:10px;letter-spacing:1.8px;font-weight:800;margin-bottom:8px}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#b2bdd8;text-align:left;padding:11px 12px;border-radius:10px;font-weight:600;display:flex;align-items:center;gap:11px}.nav button:hover{background:#ffffff0b;color:#fff}.nav button.active{background:#28264a;color:#fff;box-shadow:inset 0 0 0 1px #664ef2}.ico{width:21px;text-align:center;color:#9c7aff;font-size:17px}.side-bottom{margin-top:auto}.user{border-top:1px solid #ffffff16;padding:17px 10px 0;display:flex;align-items:center;gap:10px}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#ece7ff;color:#5536d5;font-weight:800}.user small{display:block;color:#8d98b8;font-size:11px}.user strong{font-size:12px}.main{min-width:0}.topbar{height:74px;background:#ffffffd9;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 34px;position:sticky;top:0;z-index:4;backdrop-filter:blur(16px)}.crumb{color:var(--muted);font-size:12px}.top-actions{display:flex;align-items:center;gap:11px}.preview-tag{font-size:11px;font-weight:800;letter-spacing:.5px;color:#6340da;background:#f0ebff;border:1px solid #ddd3ff;border-radius:999px;padding:7px 10px}.iconbtn{width:36px;height:36px;border:1px solid var(--line);background:#fff;border-radius:10px;color:#54617a}.content{max-width:1500px;margin:0 auto;padding:29px 34px 50px}.heading{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:22px}.heading h1{margin:0;font-size:27px;letter-spacing:-.8px}.heading p{margin:5px 0 0;color:var(--muted)}.actions{display:flex;gap:9px;align-items:center}.btn{border:1px solid var(--line);border-radius:9px;padding:10px 14px;background:#fff;color:var(--ink);font-weight:700}.btn:hover{border-color:#b9abfb;background:#fbfaff}.btn.primary{border:0;color:#fff;background:linear-gradient(110deg,var(--purple),var(--purple2));box-shadow:0 5px 13px #7046f52a}.btn.primary:hover{filter:brightness(1.05)}.btn.small{padding:7px 10px;font-size:12px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:20px}.stat,.panel{background:var(--card);border:1px solid var(--line);border-radius:15px;box-shadow:var(--shadow)}.stat{padding:17px 18px}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-weight:650;font-size:12px}.stat-number{font-size:27px;font-weight:800;letter-spacing:-1px;margin-top:8px}.stat-foot{font-size:11px;color:var(--muted);margin-top:2px}.stat-icon{width:33px;height:33px;border-radius:10px;background:#f0ebff;color:#7046f5;display:grid;place-items:center;font-size:17px}.filters{display:flex;gap:9px;align-items:center;padding:13px;border-bottom:1px solid var(--line);flex-wrap:wrap}.search{position:relative;flex:1;min-width:220px}.search input{width:100%;padding:10px 12px 10px 36px;border:1px solid var(--line);border-radius:9px;background:#fbfcfe;outline:0;color:var(--ink)}.search input:focus,select:focus,input:focus,textarea:focus{bo