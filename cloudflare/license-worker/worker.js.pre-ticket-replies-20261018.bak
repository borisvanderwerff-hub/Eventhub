      if (!name || !Number.isInteger(maxLicenses) || maxLicenses < 0 || maxLicenses > 10000 || licenseTypes.length === 0) return json({ error: "Vul een klantnaam, geldige licentielimiet en minimaal één toegestaan licentietype in." }, 400);
      if (contactEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactEmail)) return json({ error: "Vul een geldig e-mailadres in." }, 400);
