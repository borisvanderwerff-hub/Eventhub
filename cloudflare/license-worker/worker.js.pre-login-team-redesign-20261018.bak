    if (!username || username.length > 254 || !password || password.length > 512) return json({ error: "Vul je gebruikersnaam en wachtwoord in." }, 400);
    const account = await env.DB.prepare("SELECT a.id, a.password_salt, a.password_hash, a.active, a.disabled_at, c.status AS customer_status, cp.enabled AS product_enabled, p.active AS product_active FROM customer_portal_accounts a JOIN customers c ON c.id = a.customer_id JOIN customer_products cp ON cp.customer_id = c.id AND cp.product_id = 'eventhub' JOIN products p ON p.id = cp.product_id WHERE a.username = ? COLLATE NOCASE LIMIT 1").bind(username).first();
