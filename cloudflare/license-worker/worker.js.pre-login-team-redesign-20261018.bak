    const now = Date.now(), challengeHash = await digest(challengeToken);
    const challenge = await env.DB.prepare("SELECT ss.id, ss.staff_id, ss.actor_role, ss.expires_at, ss.mfa_verified, st.mfa_enabled AS staff_mfa_enabled, st.totp_secret_enc AS staff_secret, st.last_totp_counter AS staff_counter, st.revoked_at AS staff_revoked, st.must_change_password AS staff_must_change_password, om.mfa_enabled AS owner_mfa_enabled, om.totp_secret_enc AS owner_secret, om.last_totp_counter AS owner_counter FROM staff_sessions ss LEFT JOIN staff_access_tokens st ON st.id = ss.staff_id LEFT JOIN owner_mfa om ON ss.staff_id IS NULL AND om.id = 1 WHERE ss.token_hash = ? AND ss.revoked_at IS NULL").bind(challengeHash).first();
