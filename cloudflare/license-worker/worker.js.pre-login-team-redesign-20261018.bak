nt-size:10px;margin-top:3px}.permission input{accent-color:var(--purple);width:17px;height:17px}.staff-row{cursor:pointer}.staff-row.selected{background:#f7f5ff}.access-empty{padding:24px;background:#f8f9fc;border-radius:11px;text-align:center;color:var(--muted);font-size:12px}
