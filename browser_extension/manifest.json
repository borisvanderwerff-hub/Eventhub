{
  "manifest_version": 3,
  "name": "EventHub Rudder Browserassistent",
  "version": "1.6.0",
  "description": "Koppelt Rudder-evenementgegevens en aanwezigheidsregistratie veilig met EventHub. De knop op de aanwezigheidspagina haalt de presentie rechtstreeks uit EventHub, na bevestiging daar.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://werkenbijdefensie.nl/rudder/event/events*"
      ],
      "js": [
        "rudder_scrape.js",
        "event_list.js",
        "event_bulk.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://werkenbijdefensie.nl/rudder/event/events/*/attendance*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://werkenbijdefensie.nl/rudder/event/events/*/edit*"
      ],
      "js": [
        "rudder_scrape.js",
        "event_edit.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://werkenbijdefensie.nl/rudder/event/events/*/registrations*"
      ],
      "js": [
        "event_registrations.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
