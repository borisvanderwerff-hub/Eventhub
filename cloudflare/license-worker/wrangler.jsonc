{
  "$schema": "https://schema.v1.wrangler.com/config.schema.json",
  "name": "eventhub-licenses",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  // De licentiecontrole van EventHub gebruikt het workers.dev-adres; preview-URL's staan live uit.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["0 6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eventhub-licenses",
      "database_id": "68ffa97d-1965-4401-9ed4-89f34bb51629"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STAFF_AVATARS",
      "bucket_name": "cohentra-staff-avatars"
    }
  ],
  // Shop, betalingen en downloads draaien in de aparte worker cohentra-shop (map ../shop-worker).
  // RPC via deze binding is niet vanaf internet bereikbaar; deze worker geeft alleen gecontroleerde klanten/medewerkers door.
  "services": [
    { "binding": "SHOP", "service": "cohentra-shop", "entrypoint": "ShopService" }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@noreply.cohentra.digital"]
    }
  ]
}
