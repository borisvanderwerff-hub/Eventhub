      if (!sent) return json({ error: "E-mail niet verstuurd. Controleer de supportmailboxinstellingen; er is niets naar de klant verzonden.", reply: { id, message, delivery_status: deliveryStatus, created_at: createdAt } }, 502);
      return json({ ok: true, reply: { id, message, delivery_status: deliveryStatus, created_at: createdAt, sent_at: sentAt } }, 201);
    }
