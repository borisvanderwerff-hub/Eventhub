import { connect } from "cloudflare:sockets";

const SUPPORT_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cohentra | Support</title><style>
:root{color-scheme:light;--ink:#17283a;--muted:#66788b;--line:#dce5ec;--blue:#1768a6;--pale:#f3f7fa;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#f1f5f8;color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}.top{background:linear-gradient(120deg,#102c44,#1768a6);color:white;padding:22px max(22px,calc((100vw - 1200px)/2));display:flex;justify-content:space-between;align-items:center}.brand{font-size:22px;font-weight:800;letter-spacing:.12em}.brand span{font-weight:400;letter-spacing:.03em}.top p{margin:3px 0 0;color:#d2e5f3}.wrap{max-width:1200px;margin:30px auto;padding:0 20px}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:22px;margin:16px 0;box-shadow:0 3px 14px #16314c0b}h1{font-size:25px;margin:0}h2{font-size:19px;margin:0 0 12px}.muted{color:var(--muted)}label{display:block;font-weight:600;margin:12px 0 5px}input{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px}button,select{font:inherit;border:0;border-radius:7px;padding:9px 12px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e5edf4;color:var(--ink)}select{background:white;color:var(--ink);border:1px solid #bdcbd8}.actions{display:flex;gap:9px;align-items:center;margin-top:14px}.error{color:var(--red);margin-top:8px}.hidden{display:none!important}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:950px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:10px;vertical-align:top}th{font-size:13px;color:var(--muted)}.status-cell{display:flex;gap:6px}.message{white-space:pre-wrap;overflow-wrap:anywhere;max-width:480px;font-size:14px}.split{display:flex;justify-content:space-between;align-items:center;gap:12px}.icon-button{width:38px;height:38px;padding:0;border-radius:50%;background:#ffffff20;color:white;font-size:21px}.icon-button:hover{background:#ffffff35}.dialog{width:min(440px,calc(100% - 28px));border:1px solid var(--line);border-radius:12px;padding:24px;box-shadow:0 18px 60px #102c4440}.dialog::backdrop{background:#102c4470}.dialog-head{display:flex;justify-content:space-between;align-items:center}.close-button{background:transparent;color:var(--muted);font-size:24px;padding:0 6px}.dialog input{display:block}@media(max-width:600px){.wrap{padding:0 12px}.card{padding:16px}.top{padding:16px 18px}}
</style></head><body><header class="top"><div><div class="brand">COHENTRA <span>digital</span></div><p>Support inbox</p></div><button id="settingsButton" class="icon-button hidden" type="button" aria-label="Instellingen" title="Instellingen">⚙</button></header><main class="wrap">
<section id="login" class="card" style="max-width:460px;margin:46px auto"><h1>Support aanmelden</h1><p class="muted">Gebruik je Cohentra-supportaccount en authenticatorcode.</p><form id="credentialsForm"><label for="username">Gebruikersnaam</label><input id="username" autocomplete="username" required><label for="password">Wachtwoord</label><input id="password" type="password" autocomplete="current-password" required><div class="actions"><button id="loginButton">Verder</button></div><div id="loginError" class="error" role="alert"></div></form><form id="mfaForm" class="hidden"><label for="mfaCode">Authenticator- of herstelcode</label><input id="mfaCode" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" required><div class="actions"><button id="verifyButton">Aanmelden</button><button type="button" class="secondary" id="backButton">Terug</button></div><div id="mfaError" class="error" role="alert"></div></form></section>
<section id="firstPassword" class="card hidden" style="max-width:460px;margin:46px auto"><h1>Tijdelijk wachtwoord vervangen</h1><p class="muted">Kies een eigen wachtwoord om verder te gaan naar de supportinbox.</p><form id="firstPasswordForm"><label for="firstNewPassword">Nieuw wachtwoord</label><input id="firstNewPassword" type="password" autocomplete="new-password" required><label for="firstConfirmPassword">Herhaal nieuw wachtwoord</label><input id="firstConfirmPassword" type="password" autocomplete="new-password" required><div class="actions"><button id="firstPasswordButton">Wachtwoord opslaan</button></div><div id="firstPasswordError" class="error" role="alert"></div></form></section>
<section id="dashboard" class="hidden"><section class="card"><div class="split"><div><h1>Supportaanvragen</h1><p class="muted">Tickets van klanten in Cohentra.</p></div><button class="secondary" id="logout">Afmelden</button></div></section><section class="card"><div class="split"><h2>Inbox</h2><button class="secondary" id="refresh">Vernieuwen</button></div><div class="table-wrap"><table><thead><tr><th>Referentie</th><th>Klant</th><th>Onderwerp / bericht</th><th>Categorie</th><th>Aangemaakt</th><th>Status</th></tr></thead><tbody id="tickets"><tr><td colspan="6" class="muted">Laden…</td></tr></tbody></table></div><div id="ticketError" class="error" role="alert"></div></section></section></main>
<dialog id="settingsDialog" class="dialog"><div class="dialog-head"><h2>Instellingen</h2><button class="close-button" id="closeSettings" type="button" aria-label="Sluiten">×</button></div><p class="muted">Wijzig het wachtwoord van je supportaccount.</p><form id="passwordForm"><label for="currentPassword">Huidig wachtwoord</label><input id="currentPassword" type="password" autocomplete="current-password" required><label for="newPassword">Nieuw wachtwoord</label><input id="newPassword" type="password" autocomplete="new-password" required><label for="confirmPassword">Herhaal nieuw wachtwoord</label><input id="confirmPassword" type="password" autocomplete="new-password" required><div class="actions"><button id="passwordButton">Wachtwoord wijzigen</button><button class="secondary" id="cancelSettings" type="button">Annuleren</button></div><div id="passwordMessage" class="error" role="status"></div></form></dialog>
<script>
const $=id=>document.getElementById(id);let token=sessionStorage.getItem('cohentra-support-token')||'',challenge='',passwordChangeToken='';function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function showLogin(message=''){$('login').classList.remove('hidden');$('firstPassword').classList.add('hidden');$('dashboard').classList.add('hidden');$('settingsButton').classList.add('hidden');$('credentialsForm').classList.remove('hidden');$('mfaForm').classList.add('hidden');$('loginError').textContent=message}function headers(value=token){return {'Authorization':'Bearer '+value,'Content-Type':'application/json'}}async function api(path,options={}){const r=await fetch(path,{...options,headers:{...headers(),...(options.headers||{})}});let d={};try{d=await r.json()}catch{}if(r.status===401){token='';sessionStorage.removeItem('cohentra-support-token');showLogin('Je sessie is verlopen. Meld opnieuw aan.')}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}const statuses={new:'Nieuw',in_progress:'In behandeling',waiting_customer:'Wacht op klant',closed:'Afgerond'};function category(v,source,requestType){if(source==='website'){const names={maatwerksoftware:'Software op maat',procesautomatisering:'Procesautomatisering',website:'Website op maat',overig:'Verkennend gesprek'};return 'Websiteformulier · '+(names[requestType]||'Aanvraag')}return ({eventhub:'EventHub gebruiken',license:'Licentie',account:'Account / toegang',other:'Anders'})[v]||v}async function loadTickets(){const d=await api('/api/support/tickets');$('tickets').innerHTML=d.tickets.length?d.tickets.map(t=>'<tr><td><strong>'+safe(t.reference)+'</strong></td><td>'+safe(t.customer_name)+(t.source==='website'&&t.organization?'<br><span class="muted">'+safe(t.organization)+'</span>':'')+'<br><a href="mailto:'+encodeURIComponent(t.contact_email||'')+'">'+safe(t.contact_email||'Geen e-mailadres')+'</a></td><td><strong>'+safe(t.subject)+'</strong><div class="message">'+safe(t.message)+'</div></td><td>'+safe(category(t.category,t.source,t.request_type))+'</td><td>'+safe(new Date(t.created_at).toLocaleString('nl-NL'))+'</td><td><div class="status-cell"><select data-status="'+safe(t.id)+'">'+Object.entries(statuses).map(([k,v])=>'<option value="'+k+'" '+(t.status===k?'selected':'')+'>'+v+'</option>').join('')+'</select><button data-save="'+safe(t.id)+'">Opslaan</button></div></td></tr>').join(''):'<tr><td colspan="6" class="muted">Er zijn nog geen supportaanvragen.</td></tr>'}async function enter(){await loadTickets();$('login').classList.add('hidden');$('firstPassword').classList.add('hidden');$('dashboard').classList.remove('hidden');$('settingsButton').classList.remove('hidden')}async function responseJson(r){let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}
$('credentialsForm').onsubmit=async e=>{e.preventDefault();$('loginButton').disabled=true;$('loginError').textContent='';try{const d=await responseJson(await fetch('/api/auth/challenge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('username').value.trim(),password:$('password').value})}));if(!d.challenge_token)throw Error('Aanmelden met MFA is vereist.');challenge=d.challenge_token;$('credentialsForm').classList.add('hidden');$('mfaForm').classList.remove('hidden');$('mfaCode').focus()}catch(err){$('loginError').textContent=err.message}finally{$('loginButton').disabled=false}};
$('mfaForm').onsubmit=async e=>{e.preventDefault();$('verifyButton').disabled=true;$('mfaError').textContent='';try{const code=$('mfaCode').value.trim().replace(/[\s-]/g,'');const body={challenge_token:challenge,mfa_code:/^\d{6}$/.test(code)?code:'',recovery_code:/^\d{6}$/.test(code)?'':$('mfaCode').value.trim()};const d=await responseJson(await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}));if(d.password_change_required){passwordChangeToken=d.password_change_token;$('login').classList.add('hidden');$('firstPassword').classList.remove('hidden');$('firstNewPassword').focus();return}token=d.session_token;sessionStorage.setItem('cohentra-support-token',token);await enter()}catch(err){$('mfaError').textContent=err.message}finally{$('verifyButton').disabled=false}};
$('firstPasswordForm').onsubmit=async e=>{e.preventDefault();$('firstPasswordButton').disabled=true;$('firstPasswordError').textContent='';try{const d=await responseJson(await fetch('/api/auth/password/first-change',{method:'POST',headers:headers(passwordChangeToken),body:JSON.stringify({new_password:$('firstNewPassword').value,confirm_password:$('firstConfirmPassword').value})}));token=d.session_token;sessionStorage.setItem('cohentra-support-token',token);passwordChangeToken='';$('firstPasswordForm').reset();await enter()}catch(err){$('firstPasswordError').textContent=err.message}finally{$('firstPasswordButton').disabled=false}};
$('backButton').onclick=()=>{challenge='';$('mfaCode').value='';showLogin()};$('tickets').onclick=async e=>{const id=e.target.dataset.save;if(!id)return;const status=$('tickets').querySelector('[data-status="'+CSS.escape(id)+'"]').value;e.target.disabled=true;$('ticketError').textContent='';try{await api('/api/support/tickets/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify({status})});await loadTickets()}catch(err){$('ticketError').textContent=err.message}finally{e.target.disabled=false}};$('refresh').onclick=()=>loadTickets().catch(e=>$('ticketError').textContent=e.message);$('settingsButton').onclick=()=>{$('passwordForm').reset();$('passwordMessage').textContent='';$('settingsDialog').showModal()};$('closeSettings').onclick=$('cancelSettings').onclick=()=>$('settingsDialog').close();$('settingsDialog').onclick=e=>{if(e.target===$('settingsDialog'))$('settingsDialog').close()};$('passwordForm').onsubmit=async e=>{e.preventDefault();$('passwordButton').disabled=true;$('passwordMessage').textContent='';try{await api('/api/support/account/password',{method:'POST',body:JSON.stringify({current_password:$('currentPassword').value,new_password:$('newPassword').value,confirm_password:$('confirmPassword').value})});$('passwordForm').reset();$('passwordMessage').textContent='Wachtwoord gewijzigd.';setTimeout(()=>$('settingsDialog').close(),800)}catch(err){$('passwordMessage').textContent=err.message}finally{$('passwordButton').disabled=false}};$('logout').onclick=async()=>{token='';sessionStorage.removeItem('cohentra-support-token');showLogin()};if(token)enter().catch(e=>showLogin(e.message));else showLogin();
</script></body></html>`;

const CUSTOMER_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cohentra | Klantenportaal</title>
<style>
:root{color-scheme:light;--ink:#17283a;--muted:#66788b;--line:#dce5ec;--blue:#1768a6;--navy:#12324b;--pale:#f3f7fa;--green:#e9f6ed;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#f1f5f8;color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}.top{background:linear-gradient(120deg,#102c44,#1768a6);color:white;padding:25px max(22px,calc((100vw - 1080px)/2))}.brand{font-size:23px;font-weight:800;letter-spacing:.12em}.brand span{font-weight:400;letter-spacing:.03em}.top p{margin:3px 0 0;color:#d2e5f3}.wrap{max-width:1080px;margin:34px auto;padding:0 20px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:24px;margin:16px 0;box-shadow:0 5px 20px #1831480a}h1{font-size:25px;margin:0 0 5px}h2{font-size:19px;margin:0 0 10px}.muted{color:var(--muted)}label{display:block;font-weight:650;margin:13px 0 5px}input,select,textarea{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px;background:#fff}textarea{width:100%;min-height:140px;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px;font:inherit;resize:vertical}button{font:inherit;border:0;border-radius:7px;padding:10px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e8eff5;color:var(--ink)}button.danger{background:#fff0ef;color:var(--red);padding:7px 10px}.actions{display:flex;gap:10px;align-items:center;margin-top:15px}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{background:var(--pale);border-radius:9px;padding:15px}.stat strong{display:block;font-size:23px}.stat span{font-size:13px;color:var(--muted)}.error{color:var(--red);margin-top:9px}.notice{background:var(--green);border:1px solid #c8e2ce;border-radius:8px;padding:14px;margin:13px 0;overflow-wrap:anywhere}.hidden{display:none!important}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:650px}th,td{text-align:left;padding:11px 8px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:13px}.key{font:700 16px ui-monospace,monospace;word-break:break-all}.split{display:flex;justify-content:space-between;align-items:center;gap:12px}@media(max-width:650px){.wrap{margin:20px auto}.row,.grid{grid-template-columns:1fr}.card{padding:18px}.top{padding:20px}}
</style></head><body><header class="top"><div class="brand">COHENTRA <span>digital</span></div><p>Klantenportaal · EventHub</p></header><main class="wrap">
<section id="login" class="card" style="max-width:460px;margin:48px auto"><h1>Aanmelden</h1><p class="muted">Beheer je EventHub-licenties veilig op één plek.</p><form id="loginForm"><label for="username">Gebruikersnaam</label><input id="username" autocomplete="username" required><label for="password">Wachtwoord</label><input id="password" type="password" autocomplete="current-password" required><div class="actions"><button id="loginButton">Aanmelden</button><button id="forgotButton" type="button" class="secondary">Wachtwoord vergeten?</button></div><div id="loginError" class="error" role="alert"></div></form><p class="muted">Hulp nodig bij aanmelden? <a href="mailto:info@cohentra.digital?subject=Hulp%20bij%20aanmelden%20EventHub">Mail Cohentra</a>.</p></section>
<section id="forgotPanel" class="card hidden" style="max-width:460px;margin:48px auto"><h1>Wachtwoord herstellen</h1><p class="muted">Vul het e-mailadres in dat bij je klantaccount hoort. Als er een account is, sturen we een beveiligde link.</p><form id="forgotForm"><label for="forgotEmail">E-mailadres</label><input id="forgotEmail" type="email" autocomplete="email" required><div class="actions"><button id="forgotSubmit">Herstellink sturen</button><button type="button" id="backToLogin" class="secondary">Terug</button></div><div id="forgotMessage" role="status"></div></form></section>
<section id="tokenPanel" class="card hidden" style="max-width:460px;margin:48px auto"><h1 id="tokenTitle">Wachtwoord instellen</h1><p class="muted">Kies een wachtwoord voor je bestaande klantenportaalaccount.</p><form id="tokenForm"><label for="tokenPassword">Nieuw wachtwoord</label><input id="tokenPassword" type="password" autocomplete="new-password" required><label for="tokenPasswordConfirm">Herhaal wachtwoord</label><input id="tokenPasswordConfirm" type="password" autocomplete="new-password" required><div class="actions"><button id="tokenSubmit">Wachtwoord opslaan</button></div><div id="tokenMessage" class="error" role="alert"></div></form></section>
<div id="dashboard" class="hidden"><section class="card"><div class="split"><div><h1 id="welcome">Klantenportaal</h1><p class="muted">Beheer zelf de EventHub-licenties die bij jouw klantaccount horen.</p></div><button class="secondary" id="logout">Afmelden</button></div><div class="grid"><div class="stat"><strong id="used">—</strong><span>Licenties in gebruik</span></div><div class="stat"><strong id="limit">—</strong><span>Maximaal toegestaan</span></div><div class="stat"><strong id="types">—</strong><span>Toegestane typen</span></div></div></section>
<section class="card"><h2>Licentie aanmaken</h2><form id="createForm"><div class="row"><div><label for="label">Naam / gebruiker (optioneel)</label><input id="label" maxlength="80" placeholder="Bijvoorbeeld Testgebruiker"></div><div><label for="type">Licentietype</label><select id="type"></select></div></div><div class="row" id="dates"><div><label for="validFrom">Geldig vanaf</label><input id="validFrom" type="date" required></div><div><label for="validUntil">Geldig tot en met</label><input id="validUntil" type="date" required></div></div><div class="actions"><button id="createButton">Licentie aanmaken</button></div><div id="createError" class="error" role="alert"></div><div id="createdKey" class="notice hidden"><strong>Bewaar deze sleutel; hij wordt hierna niet opnieuw getoond.</strong><p class="key" id="keyValue"></p><button type="button" class="secondary" id="copyKey">Kopieer sleutel</button></div></form></section>
<section class="card"><div class="split"><h2>Mijn licenties</h2><button class="secondary" id="refresh">Vernieuwen</button></div><div class="table-wrap"><table><thead><tr><th>Naam</th><th>Type</th><th>Geldig vanaf</th><th>Geldig tot</th><th>Status</th><th></th></tr></thead><tbody id="licenses"><tr><td colspan="6" class="muted">Laden…</td></tr></tbody></table></div></section>
<section class="card"><h2>Supportaanvraag indienen</h2><p class="muted">Omschrijf je vraag. Stuur geen wachtwoorden of volledige licentiesleutels mee.</p><form id="ticketForm"><div class="row"><div><label for="ticketCategory">Onderwerp</label><select id="ticketCategory"><option value="eventhub">EventHub gebruiken</option><option value="license">Licentie</option><option value="account">Account / toegang</option><option value="other">Anders</option></select></div><div><label for="ticketSubject">Korte omschrijving</label><input id="ticketSubject" maxlength="120" required></div></div><label for="ticketMessage">Waar kunnen we mee helpen?</label><textarea id="ticketMessage" maxlength="6000" required></textarea><div class="actions"><button id="ticketButton">Supportaanvraag versturen</button></div><div id="ticketError" class="error" role="alert"></div><div id="ticketCreated" class="notice hidden" role="status"></div></form><h2 style="margin-top:24px">Mijn supportaanvragen</h2><div class="table-wrap"><table><thead><tr><th>Referentienummer</th><th>Onderwerp</th><th>Datum</th><th>Status</th></tr></thead><tbody id="myTickets"><tr><td colspan="4" class="muted">Laden…</td></tr></tbody></table></div><p class="muted">Liever e-mailen? <a href="mailto:support@cohentra.digital?subject=EventHub%20supportverzoek">support@cohentra.digital</a></p></section>
<section class="card"><h2>Wachtwoord wijzigen</h2><form id="passwordForm"><div class="row"><div><label for="oldPassword">Huidig wachtwoord</label><input id="oldPassword" type="password" autocomplete="current-password" required></div><div><label for="newPassword">Nieuw wachtwoord</label><input id="newPassword" type="password" autocomplete="new-password" required></div></div><div class="actions"><button class="secondary">Wachtwoord wijzigen</button></div><div id="passwordMessage" class="error" role="status"></div></form></section></div></main>
<script>
const $=id=>document.getElementById(id);let token=sessionStorage.getItem('cohentra-customer-token')||'',customer={};function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function headers(){return {'Authorization':'Bearer '+token,'Content-Type':'application/json'}}async function api(path,options={}){const r=await fetch(path,{...options,headers:{...headers(),...(options.headers||{})}});let d={};try{d=await r.json()}catch{}if(r.status===401){token='';sessionStorage.removeItem('cohentra-customer-token');if(!$('login').classList.contains('hidden')){}else showLogin('Je sessie is verlopen. Meld opnieuw aan.')}if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}function showLogin(error=''){$('login').classList.remove('hidden');$('dashboard').classList.add('hidden');$('loginError').textContent=error}function dateToday(){return new Date().toISOString().slice(0,10)}async function load(){const [me,list]=await Promise.all([api('/api/customer/me'),api('/api/customer/licenses')]);customer=me.customer;$('welcome').textContent='Welkom, '+customer.name;$('used').textContent=customer.licenses_in_use;$('limit').textContent=customer.max_licenses;$('types').textContent=customer.allowed_license_types.map(x=>x==='admin'?'Beheerder':'Gesloten beta').join(', ');$('type').innerHTML=customer.allowed_license_types.map(x=>'<option value="'+safe(x)+'">'+(x==='admin'?'Beheerder':'Gesloten beta')+'</option>').join('');$('dates').classList.toggle('hidden',customer.allowed_license_types.length===1&&customer.allowed_license_types[0]==='admin');$('validFrom').value=dateToday();$('validUntil').value=dateToday();$('licenses').innerHTML=list.licenses.length?list.licenses.map(x=>'<tr><td>'+safe(x.label||'—')+'</td><td>'+safe(x.license_type)+'</td><td>'+safe(x.valid_from)+'</td><td>'+safe(x.valid_until)+'</td><td>'+safe(x.status)+'</td><td>'+(x.revoked_at?'':'<button class="danger" data-revoke="'+safe(x.id)+'">Intrekken</button>')+'</td></tr>').join(''):'<tr><td colspan="6" class="muted">Er zijn nog geen licenties.</td></tr>';await loadTickets();if($('type').value==='admin')$('dates').classList.add('hidden');$('dashboard').classList.remove('hidden');$('login').classList.add('hidden')}async function loadTickets(){const d=await api('/api/customer/tickets');$('myTickets').innerHTML=d.tickets.length?d.tickets.map(t=>'<tr><td><strong>'+safe(t.reference)+'</strong></td><td>'+safe(t.subject)+'</td><td>'+safe(new Date(t.created_at).toLocaleString('nl-NL'))+'</td><td>'+safe(ticketStatusLabel(t.status))+'</td></tr>').join(''):'<tr><td colspan="4" class="muted">Je hebt nog geen supportaanvragen.</td></tr>'}function ticketStatusLabel(s){return ({new:'Nieuw',in_progress:'In behandeling',waiting_customer:'Wacht op jou',closed:'Afgerond'})[s]||s}
$('type').onchange=()=>{$('dates').classList.toggle('hidden',$('type').value==='admin')};$('loginForm').onsubmit=async e=>{e.preventDefault();const b=$('loginButton');b.disabled=true;$('loginError').textContent='';try{const d=await fetch('/api/customer/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('username').value.trim(),password:$('password').value})});const result=await d.json();if(!d.ok)throw Error(result.error||'Aanmelden mislukt.');token=result.session_token;sessionStorage.setItem('cohentra-customer-token',token);await load()}catch(err){$('loginError').textContent=err.message}finally{b.disabled=false}};$('forgotButton').onclick=()=>{ $('login').classList.add('hidden');$('forgotPanel').classList.remove('hidden');$('forgotEmail').value=$('username').value.includes('@')?$('username').value:'';$('forgotEmail').focus()};$('backToLogin').onclick=()=>{$('forgotPanel').classList.add('hidden');$('login').classList.remove('hidden')};$('forgotForm').onsubmit=async e=>{e.preventDefault();$('forgotSubmit').disabled=true;$('forgotMessage').textContent='';try{const r=await fetch('/api/customer/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:$('forgotEmail').value.trim()})});const d=await r.json();if(!r.ok)throw Error(d.error||'Versturen is niet gelukt.');$('forgotMessage').textContent=d.message;$('forgotMessage').className='notice'}catch(err){$('forgotMessage').textContent=err.message;$('forgotMessage').className='error'}finally{$('forgotSubmit').disabled=false}};$('tokenForm').onsubmit=async e=>{e.preventDefault();const tokenParam=new URL(location.href).searchParams.get('token'),flow=new URL(location.href).searchParams.get('flow');$('tokenSubmit').disabled=true;$('tokenMessage').textContent='';try{if($('tokenPassword').value!==$('tokenPasswordConfirm').value)throw Error('De wachtwoorden komen niet overeen.');const r=await fetch('/api/customer/auth/complete-email-auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:tokenParam,flow,password:$('tokenPassword').value})});const d=await r.json();if(!r.ok)throw Error(d.error||'De link is verlopen of ongeldig.');history.replaceState({},'',location.pathname);$('tokenPanel').classList.add('hidden');$('login').classList.remove('hidden');$('loginError').textContent='Je wachtwoord is ingesteld. Je kunt nu aanmelden.'}catch(err){$('tokenMessage').textContent=err.message}finally{$('tokenSubmit').disabled=false}};const params=new URL(location.href).searchParams;if(params.get('token')&&['invite','reset'].includes(params.get('flow'))){$('login').classList.add('hidden');$('tokenPanel').classList.remove('hidden');if(params.get('flow')==='reset')$('tokenTitle').textContent='Nieuw wachtwoord kiezen'}$('logout').onclick=async()=>{try{await api('/api/customer/auth/logout',{method:'POST',body:'{}'})}catch{}token='';sessionStorage.removeItem('cohentra-customer-token');showLogin()};$('refresh').onclick=()=>load().catch(e=>showLogin(e.message));$('createForm').onsubmit=async e=>{e.preventDefault();$('createError').textContent='';$('createdKey').classList.add('hidden');$('createButton').disabled=true;try{const d=await api('/api/customer/licenses',{method:'POST',body:JSON.stringify({label:$('label').value.trim(),license_type:$('type').value,valid_from:$('validFrom').value,valid_until:$('validUntil').value})});$('keyValue').textContent=d.license.license_key;$('createdKey').classList.remove('hidden');$('copyKey').onclick=()=>navigator.clipboard.writeText(d.license.license_key);$('label').value='';await load()}catch(err){$('createError').textContent=err.message}finally{$('createButton').disabled=false}};$('ticketForm').onsubmit=async e=>{e.preventDefault();$('ticketError').textContent='';$('ticketCreated').classList.add('hidden');$('ticketButton').disabled=true;try{const d=await api('/api/customer/tickets',{method:'POST',body:JSON.stringify({category:$('ticketCategory').value,subject:$('ticketSubject').value.trim(),message:$('ticketMessage').value.trim()})});$('ticketCreated').innerHTML='Je supportaanvraag is aangemaakt. Bewaar je referentienummer: <strong class="key">'+safe(d.reference)+'</strong>. Je kunt de status hieronder volgen.'+(d.email_sent?' Een melding is ook naar Cohentra Support verstuurd.':' De e-mailmelding kon niet worden verstuurd; je aanvraag staat wel in het portaal. Vermeld het referentienummer als je contact opneemt via support@cohentra.digital.');$('ticketCreated').classList.remove('hidden');$('ticketForm').reset();await loadTickets()}catch(err){$('ticketError').textContent=err.message}finally{$('ticketButton').disabled=false}};$('licenses').onclick=async e=>{const id=e.target.dataset.revoke;if(!id)return;if(!confirm('Deze licentie intrekken? De licentie kan daarna niet meer worden gebruikt.'))return;e.target.disabled=true;try{await api('/api/customer/licenses/'+encodeURIComponent(id)+'/revoke',{method:'POST',body:'{}'});await load()}catch(err){alert(err.message)}finally{e.target.disabled=false}};$('passwordForm').onsubmit=async e=>{e.preventDefault();$('passwordMessage').textContent='';try{const d=await api('/api/customer/account/password',{method:'POST',body:JSON.stringify({old_password:$('oldPassword').value,new_password:$('newPassword').value})});token=d.session_token;sessionStorage.setItem('cohentra-customer-token',token);$('passwordForm').reset();$('passwordMessage').textContent='Wachtwoord gewijzigd.';await load()}catch(err){$('passwordMessage').textContent=err.message}};if(token)load().catch(e=>showLogin(e.message));else showLogin();
</script></body></html>`;

const ADMIN_HTML = String.raw`<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cohentra Admin</title>
<style>
:root{color-scheme:light;--ink:#122337;--muted:#66778a;--line:#dce4eb;--blue:#145da0;--pale:#f3f7fa;--red:#a33333}*{box-sizing:border-box}body{margin:0;background:#eef3f7;color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{max-width:960px;margin:40px auto;padding:0 20px}.head{margin-bottom:22px}.head h1{margin:0;font-size:28px}.head p{margin:4px 0;color:var(--muted)}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:22px;margin:16px 0;box-shadow:0 3px 14px #16314c0b}h2{font-size:19px;margin:0 0 14px}label{display:block;font-weight:600;margin:12px 0 5px}input{font:inherit;width:100%;padding:10px 12px;border:1px solid #bdcbd8;border-radius:7px}button{font:inherit;border:0;border-radius:7px;padding:10px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:650}button.secondary{background:#e5edf4;color:var(--ink)}button.danger{background:#fff1f0;color:var(--red);padding:7px 10px}button:disabled{opacity:.6;cursor:wait}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.actions{display:flex;gap:10px;align-items:center;margin-top:16px}.error{color:var(--red);margin-top:8px}.notice{background:#edf7ef;border:1px solid #bfdcc5;border-radius:8px;padding:14px;margin:14px 0;overflow-wrap:anywhere}.key{font:700 18px ui-monospace,monospace;letter-spacing:.04em}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:650px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:10px 8px;vertical-align:middle}th{font-size:13px;color:var(--muted)}.muted{color:var(--muted)}.hidden{display:none!important}.topline{display:flex;justify-content:space-between;align-items:center;gap:12px}@media(max-width:600px){.wrap{margin:22px auto}.row{grid-template-columns:1fr}.card{padding:17px}}
.ticket-subject{background:transparent;color:var(--ink);padding:0;text-align:left;font-weight:750}.ticket-subject:hover{text-decoration:underline}.ticket-dialog{width:min(860px,calc(100% - 28px));max-height:88vh;overflow:auto;border:1px solid var(--line);border-radius:14px;padding:24px;box-shadow:0 18px 60px #102c4440}.ticket-dialog::backdrop{background:#102c4470}.conversation{display:grid;gap:12px;max-height:42vh;overflow:auto;margin:18px 0}.conversation-message{padding:14px 16px;border:1px solid var(--line);border-radius:10px;background:var(--pale)}.support-message{background:#f1f6ff;border-color:#cbdcf5}.conversation-meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:13px}.conversation-text{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:8px}.sent-label{color:#18794e;font-size:12px;margin:8px 0 0}.ticket-dialog textarea{font:inherit;width:100%;min-height:130px;resize:vertical;padding:12px;border:1px solid #bdcbd8;border-radius:8px}.ticket-dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}</style><style>.key-table-wrap{max-height:300px;overflow:auto;margin:12px 0}.key-table{min-width:520px;width:100%;table-layout:fixed}.key-table th:first-child{width:150px}.key-table td{overflow-wrap:anywhere}.key-table .key-value{font:600 14px ui-monospace,monospace;word-break:break-all}.key-copy{white-space:nowrap}.actions-menu{position:relative;display:inline-block}.actions-menu summary{list-style:none;cursor:pointer;display:grid;place-items:center;width:34px;height:32px;border:1px solid var(--line);border-radius:7px;font-size:22px;line-height:1}.actions-menu summary::-webkit-details-marker{display:none}.menu-items{position:absolute;right:0;top:calc(100% + 4px);z-index:10;min-width:160px;padding:6px;display:grid;gap:4px;background:white;border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 20px #12233724}.menu-items button{background:transparent;color:var(--ink);text-align:left;padding:8px 10px;font-weight:500;white-space:nowrap}.menu-items button:hover{background:var(--pale)}.menu-items button.menu-danger{color:var(--red)}.license-group{border:1px solid var(--line);border-radius:8px;margin:10px 0;overflow:visible}.license-group>summary{cursor:pointer;padding:12px 14px;font-weight:700;background:var(--pale);border-radius:8px}.license-group[open]>summary{border-radius:8px 8px 0 0}.license-group .table-wrap{padding:0 8px 8px}.license-group table{min-width:820px}.bulk-controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0;padding:12px;background:var(--pale);border:1px solid var(--line);border-radius:8px}.bulk-controls select{font:inherit;width:auto;min-width:180px;padding:9px;border:1px solid #bdcbd8;border-radius:7px;background:white}.license-select{width:18px;height:18px;vertical-align:middle}dialog{width:min(440px,calc(100vw - 32px));border:1px solid var(--line);border-radius:12px;padding:22px;color:var(--ink);box-shadow:0 18px 60px #12233755}dialog::backdrop{background:#10233788}dialog h2{margin:0 0 8px}dialog p{margin:0;color:var(--muted)}dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}</style>
<style>
body{background:#f3f6f9}
.app-wrap{width:100%;max-width:none;margin:0;padding:0}
.app-wrap>.head{width:min(560px,calc(100% - 40px));margin:40px auto 22px}
.app-wrap>#login,.app-wrap>#loginMfa,.app-wrap>#bootstrap,.app-wrap>#mfaSetup{width:min(560px,calc(100% - 40px));margin:16px auto}
.app-shell{display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}
.sidebar{position:sticky;top:0;height:100vh;background:#112439;color:#f4f8fb;padding:25px 15px 18px;display:flex;flex-direction:column;gap:28px}
.brand{display:flex;align-items:center;gap:11px;padding:0 10px}.brand-mark{width:38px;height:38px;display:grid;place-items:center;background:#1b6eae;border-radius:11px;color:white;font-size:20px;font-weight:800}.brand strong,.brand small{display:block}.brand strong{font-size:16px;letter-spacing:.02em}.brand small{font-size:12px;color:#aebdcb;margin-top:1px}
.nav-list{display:grid;gap:5px}.nav-item{display:flex;align-items:center;gap:12px;width:100%;padding:11px 12px;border:1px solid transparent;border-radius:8px;background:transparent;color:#cbd7e2;text-align:left;font-weight:600}.nav-item:hover{background:#1b344b;color:white}.nav-item.active{background:#214969;border-color:#315c7a;color:#fff}.nav-icon{width:20px;text-align:center;font-size:18px;line-height:1}
.sidebar-spacer{flex:1}.sidebar-logout{width:100%;background:transparent;color:#d8e2eb;border:1px solid #354b60;text-align:left}.sidebar-logout:hover{background:#1b344b}
.main-area{width:100%;max-width:1440px;min-width:0;margin:0 auto;padding:40px clamp(22px,4vw,58px) 64px}
.page-heading{margin:0 0 25px}.page-heading h1{margin:3px 0 5px;font-size:32px;line-height:1.2}.page-heading p{margin:0 0 15px;color:var(--muted)}.eyebrow{color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.12em}
.overview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.stat-card{background:white;border:1px solid var(--line);border-radius:12px;padding:19px 20px;box-shadow:0 3px 14px #16314c0b}.stat-label{display:block;color:var(--muted);font-size:13px;font-weight:600}.stat-value{display:block;margin-top:7px;font-size:30px;line-height:1.1;font-weight:750;letter-spacing:-.03em}.overview-actions{margin-top:18px}.quick-actions{display:flex;flex-wrap:wrap;gap:10px}.quick-actions button{min-height:42px}
.mobile-topbar{display:none}.mobile-menu-backdrop{display:none;position:fixed;inset:0;z-index:40;padding:0;border:0;border-radius:0;background:#0b1c2db0}.admin-view{min-width:0}
@media(max-width:820px){.app-shell{display:block}.sidebar{position:fixed;inset:0 auto 0 0;z-index:41;width:min(280px,85vw);height:100dvh;transform:translateX(-105%);transition:transform .22s ease;box-shadow:12px 0 36px #07192b2b}.sidebar.sidebar-open{transform:translateX(0)}.mobile-menu-backdrop.open{display:block}.mobile-topbar{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;margin:-24px -16px 24px;padding:12px 16px;background:#fff;border-bottom:1px solid var(--line)}.mobile-topbar strong{font-size:15px}.mobile-topbar span{color:var(--muted);font-size:13px}.mobile-topbar button{padding:8px 11px}.main-area{padding:24px 16px 46px}.overview-grid{grid-template-columns:1fr}.page-heading h1{font-size:28px}}
@media(prefers-reduced-motion:reduce){.sidebar{transition:none}}
</style>
</head><body><main class="wrap app-wrap">
<header class="head" id="portalHeader"><h1>Cohentra Admin</h1><p>Klanten, producttoegang en licenties beheren.</p></header>
<section class="card" id="login"><h2>Aanmelden</h2><label for="username">Gebruikersnaam</label><input id="username" autocomplete="username"><label for="password">Wachtwoord</label><input id="password" type="password" autocomplete="current-password"><p class="muted">Vul eerst je accountgegevens in.</p><div class="actions"><button id="loginBtn">Verder</button><button class="secondary" id="showSetup">Eerste beheerder instellen</button></div><div id="loginError" class="error"></div></section>
<section class="card hidden" id="loginMfa"><h2>Authenticatorcode</h2><p class="muted">Account: <strong id="mfaUsername"></strong>. Vul nu de actuele code uit Google Authenticator in, of gebruik een herstelcode.</p><label for="mfaCode">Authenticator- of herstelcode</label><input id="mfaCode" inputmode="numeric" autocomplete="one-time-code" placeholder="XXX-XXX"><div class="actions"><button id="verifyMfa">Aanmelden</button><button class="secondary" id="backToCredentials">Terug</button></div><div id="mfaLoginError" class="error"></div></section>
<section class="card hidden" id="bootstrap"><h2>Eerste Cohentra-beheerder instellen</h2><p class="muted">Gebruik de Worker-beheerderssleutel alleen voor deze eenmalige installatie.</p><label for="bootstrapToken">Worker-beheerderssleutel</label><input id="bootstrapToken" type="password" autocomplete="off"><label for="ownerUsername">Gebruikersnaam</label><input id="ownerUsername" autocomplete="username"><label for="ownerPassword">Wachtwoord</label><input id="ownerPassword" type="password" autocomplete="new-password"><div class="actions"><button id="beginSetup">Authenticator instellen</button><button class="secondary" id="cancelSetup">Terug</button></div><div id="bootstrapError" class="error"></div></section>
<section class="card hidden" id="mfaSetup"><h2>Google Authenticator instellen</h2><p class="muted">Scan deze QR-code in Google Authenticator. Lukt scannen niet, kies dan handmatig instellen en vul de sleutel hieronder in.</p><div id="mfaQr" class="notice" style="width:max-content;max-width:100%;margin:14px auto"></div><label>Sleutel voor handmatige invoer</label><div id="mfaSecret" class="notice key"></div><label for="setupCode">Actuele authenticatorcode</label><input id="setupCode" inputmode="numeric" autocomplete="one-time-code" placeholder="XXX-XXX" maxlength="7"><div class="actions"><button id="confirmMfa">2FA activeren</button></div><div id="setupError" class="error"></div><div id="recoveryCodes" class="notice hidden"></div><button id="finishSetup" class="secondary hidden">Naar aanmelden</button></section>
<div id="dashboard" class="hidden">
<div class="app-shell">
<aside class="sidebar" id="sidebar" aria-label="Hoofdnavigatie">
<div class="brand"><span class="brand-mark" aria-hidden="true">C</span><span><strong>Cohentra</strong><small>Beheerportal</small></span></div>
<nav class="nav-list" aria-label="Hoofdmenu">
<button type="button" class="nav-item active" data-view="overview" aria-current="page"><span class="nav-icon" aria-hidden="true">▦</span>Overzicht</button>
<button type="button" class="nav-item" data-view="customers"><span class="nav-icon" aria-hidden="true">♙</span>Klanten</button>
<button type="button" class="nav-item" data-view="licenses"><span class="nav-icon" aria-hidden="true">▤</span>Licenties</button>
<button type="button" class="nav-item hidden" id="supportNav" data-view="support"><span class="nav-icon" aria-hidden="true">♧</span>Support</button>
</nav>
<div class="sidebar-spacer"></div><button type="button" class="sidebar-logout" id="logout">Afmelden</button>
</aside>
<button type="button" class="mobile-menu-backdrop" id="menuBackdrop" aria-label="Menu sluiten"></button>
<div class="main-area">
<div class="mobile-topbar"><button type="button" id="menuToggle" aria-expanded="false" aria-label="Menu openen">☰</button><strong>Cohentra</strong><span id="mobilePageTitle">Overzicht</span></div>
<section class="admin-view" id="view-overview"><div class="page-heading"><span class="eyebrow">STARTPUNT</span><h1 id="pageTitle">Overzicht</h1><p>Beheer klanten, licenties en support vanuit één plek.</p></div>
<div class="overview-grid"><div class="stat-card"><span class="stat-label">Klanten</span><strong class="stat-value" id="statCustomers">—</strong></div><div class="stat-card"><span class="stat-label">Licenties</span><strong class="stat-value" id="statLicenses">—</strong></div><div class="stat-card"><span class="stat-label">Groepen</span><strong class="stat-value" id="statGroups">—</strong></div></div>
<section class="card overview-actions"><h2>Snel naar</h2><div class="quick-actions"><button type="button" class="secondary" data-go-view="customers">Klanten beheren</button><button type="button" id="goIssueLicense">Licentie uitgeven</button><button type="button" class="secondary owner-shortcut hidden" data-go-view="support">Support</button></div></section></section>
<section class="admin-view hidden" id="view-customers">
<section class="card" id="customersPanel"><div class="topline"><div><h2>Klanten</h2><p class="muted">Stel per klant in welke EventHub-licenties beschikbaar zijn.</p></div></div>
<form id="customerForm" class="hidden"><input type="hidden" id="customerId"><div class="row"><div><label for="customerName">Klantnaam</label><input id="customerName" maxlength="120" required></div><div><label for="customerContact">Contactpersoon</label><input id="customerContact" maxlength="120"></div></div><label for="customerEmail">E-mailadres</label><input id="customerEmail" type="email" maxlength="254"><label for="customerNotes">Notities</label><input id="customerNotes" maxlength="2000"><div class="row"><div><label for="customerLimit">Maximaal aantal gelijktijdig geldige licenties</label><input id="customerLimit" type="number" min="0" max="10000" value="5" required></div><div><label>Toegestane EventHub-licenties</label><label><input id="allowBeta" type="checkbox" checked style="width:auto;margin-right:8px">Gesloten beta</label><label><input id="allowAdmin" type="checkbox" style="width:auto;margin-right:8px">Beheerder</label></div></div><div class="actions"><button id="saveCustomer">Klant opslaan</button><button type="button" class="secondary" id="cancelCustomer">Annuleren</button></div><div id="customerError" class="error"></div></form>
<div class="actions" id="customerActions"><button id="addCustomer">Klant toevoegen</button></div><div class="table-wrap"><table><thead><tr><th>Klant</th><th>Contact</th><th>EventHub-licenties</th><th>Toegestaan</th><th>Status</th><th></th></tr></thead><tbody id="customers"><tr><td colspan="6" class="muted">Laden…</td></tr></tbody></table></div><div id="portalCredentials" class="notice hidden"></div></section></section>

<section class="admin-view hidden" id="view-support"><div class="page-heading"><span class="eyebrow">KLANTCONTACT</span><h1>Support</h1><p>Beheer supportaanvragen en supportaccounts vanuit één plek.</p></div><section class="card"><div class="topline"><div><h2>Inbox</h2><p class="muted">Alle supporttickets, inclusief inzendingen via het contactformulier.</p></div><button type="button" class="secondary" id="refreshSupport">Vernieuwen</button></div><div class="bulk-controls"><label for="supportStatusFilter">Status</label><select id="supportStatusFilter"><option value="all">Alle statussen</option><option value="new">Nieuw</option><option value="in_progress">In behandeling</option><option value="waiting_customer">Wacht op klant</option><option value="closed">Afgerond</option></select><label for="supportSourceFilter">Herkomst</label><select id="supportSourceFilter"><option value="all">Alle herkomsten</option><option value="website">Contactformulier</option><option value="portal">Klantenportaal</option></select></div><div id="supportTicketError" class="error" role="alert"></div><div class="table-wrap"><table style="min-width:1000px"><thead><tr><th>Referentie</th><th>Afzender</th><th>Onderwerp en bericht</th><th>Herkomst</th><th>Ontvangen</th><th>Status</th></tr></thead><tbody id="supportTickets"><tr><td colspan="6" class="muted">Open Support om de inbox te laden.</td></tr></tbody></table></div></section><section class="card hidden" id="staffPanel"><div class="topline"><div><h2>Supportaccounts</h2><p class="muted">Maak hier accounts voor medewerkers die tickets behandelen op support.cohentra.digital.</p></div><button type="button" class="secondary" id="addStaff">Supportaccount toevoegen</button></div><div id="staffCreatePanel" class="hidden"><div class="row"><div><label for="staffName">Naam</label><input id="staffName" maxlength="80" required><label for="staffUsername">Gebruikersnaam</label><input id="staffUsername" maxlength="254" autocomplete="off" required><label for="staffTemporaryPassword">Eenmalig wachtwoord</label><input id="staffTemporaryPassword" type="password" maxlength="512" autocomplete="new-password"><p class="muted">Vul zelf een tijdelijk wachtwoord in of laat dit leeg om er automatisch een te maken. Na de eerste MFA-aanmelding moet de medewerker dit wachtwoord vervangen.</p></div><div class="actions"><button id="createStaff">Supportaccount aanmaken</button></div></div><div class="actions"><button type="button" class="secondary" id="cancelStaff">Annuleren</button></div></div><div id="staffError" class="error"></div><div id="staffKey" class="notice hidden"></div><div class="table-wrap"><table><thead><tr><th>Naam</th><th>Aangemaakt</th><th>Laatst gebruikt</th><th>Status</th><th></th></tr></thead><tbody id="staff"><tr><td colspan="5" class="muted">Laden…</td></tr></tbody></table></div></section>

</section>

<section class="admin-view hidden" id="view-licenses"><div class="page-heading"><span class="eyebrow">TOEGANG BEHEREN</span><h1>Licenties</h1><p>Geef licenties uit en beheer ze per klant en groep.</p><button type="button" id="showIssueLicense">Licentie uitgeven</button></div><section class="card hidden" id="issueLicensePanel"><div class="topline"><h2>Nieuwe licenties</h2><button type="button" class="secondary" id="cancelIssueLicense">Annuleren</button></div><label for="label">Naam of herkenning (optioneel)</label><input id="label" maxlength="80" placeholder="Bijvoorbeeld tester"><label for="customerSelect">Klantaccount</label><select id="customerSelect"><option value="">Cohentra / intern</option></select><label for="group">Groep</label><select id="group"><option value="">Geen groep</option></select><div class="row"><div><label for="count">Aantal licenties (1–100)</label><input id="count" type="number" min="1" max="100" value="1"></div><div><label for="type">Licentietype</label><select id="type"><option value="beta">Gesloten beta</option><option value="admin">Beheerder</option></select></div></div><div class="row"><div><label for="from">Geldig vanaf</label><input id="from" type="date" required></div><div><label for="until">Geldig tot en met</label><input id="until" type="date" required></div></div><label><input id="unlimited" type="checkbox" style="width:auto;margin-right:8px">Onbeperkt geldig</label><div class="actions"><button id="createBtn">Licenties aanmaken</button></div><div id="createError" class="error"></div><div id="newKey" class="notice hidden"></div></section>
<section class="card"><div class="topline"><h2>Uitgegeven licenties</h2><button class="secondary" id="refresh">Vernieuwen</button></div><div id="bulkControls" class="bulk-controls hidden"><strong id="selectedCount">0 geselecteerd</strong><label class="hidden" for="bulkGroup">Nieuwe groep</label><select id="bulkGroup" aria-label="Kies de groep voor de geselecteerde licenties"><option value="">Geen groep</option></select><button id="bulkMove">Verplaatsen</button><button class="secondary" id="clearSelection">Selectie wissen</button></div><div id="licenses"><p class="muted">Laden…</p></div></section>
<section class="card"><div class="topline"><h2>Groepen beheren</h2><button id="createGroup">Groep toevoegen</button></div><div class="table-wrap"><table><thead><tr><th>Groep</th><th>Aantal licenties</th><th></th></tr></thead><tbody id="groups"><tr><td colspan="3" class="muted">Laden…</td></tr></tbody></table></div></section></section>
<dialog id="supportTicketDialog" class="ticket-dialog"><div class="dialog-head"><div><span class="eyebrow">SUPPORTTICKET</span><h2 id="supportDetailTitle">Ticket</h2></div><button type="button" class="close-button" id="closeSupportTicket" aria-label="Sluiten">×</button></div><p id="supportDetailMeta" class="muted"></p><div id="supportConversation" class="conversation" aria-live="polite"></div><form id="supportReplyForm"><label for="supportReplyMessage">Antwoord aan de klant</label><textarea id="supportReplyMessage" maxlength="6000" placeholder="Schrijf je antwoord…" required></textarea><p class="muted">Dit antwoord wordt verstuurd vanuit support@cohentra.digital. Reacties komen in de mailbox, maar worden niet automatisch aan dit ticket gekoppeld.</p><div id="supportDetailError" class="error" role="alert"></div><div class="dialog-actions"><button type="button" class="secondary" id="cancelSupportReply">Sluiten</button><button id="supportReplyButton">Antwoord versturen</button></div></form></dialog><dialog id="groupDialog"><form id="groupForm"><h2>Groep toevoegen</h2><p>Geef de nieuwe groep een herkenbare naam.</p><label for="groupName">Groepsnaam</label><input id="groupName" maxlength="60" placeholder="Bijvoorbeeld Testgebruikers" required><div id="groupError" class="error"></div><div class="dialog-actions"><button type="button" class="secondary" id="cancelGroup">Annuleren</button><button id="saveGroup">Opslaan</button></div></form></dialog>
</div></section></div></div></main>
<script>
const $=id=>document.getElementById(id);
let token=sessionStorage.getItem('eventhub-admin-token')||'', pendingChallenge='', role='', customers=[], licenseSummary={licenses:0,groups:0}, supportTicketRows=[];
function today(){return new Date().toISOString().slice(0,10)}
function authHeaders(){return {'Authorization':'Bearer '+token,'Content-Type':'application/json'}}
async function api(path,opts={}){const r=await fetch(path,{...opts,headers:{...authHeaders(),...(opts.headers||{})}});let d={};try{d=await r.json()}catch{}if(r.status===401)throw Error('Toegangscode ongeldig of ingetrokken.');if(!r.ok)throw Error(d.error||'De aanvraag is mislukt.');return d}
function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function otpauthUri(account,secret){return 'otpauth://totp/'+encodeURIComponent('Cohentra:'+account)+'?secret='+encodeURIComponent(secret)+'&issuer=Cohentra'}
function qrSvg(text){
  const bytes=[...new TextEncoder().encode(text)],version=5,size=version*4+17,dataCount=108,eccCount=26;
  if(bytes.length>106)throw Error('De QR-inhoud is te lang. Gebruik de handmatige sleutel.');
  const bits=[],push=(value,length)=>{for(let i=length-1;i>=0;i--)bits.push((value>>>i)&1)};
  push(4,4);push(bytes.length,8);for(const b of bytes)push(b,8);for(let i=0;i<Math.min(4,dataCount*8-bits.length);i++)bits.push(0);while(bits.length%8)bits.push(0);
  const data=[];for(let i=0;i<bits.length;i+=8){let v=0;for(let j=0;j<8;j++)v=(v<<1)|bits[i+j];data.push(v)}for(let pad=0;data.length<dataCount;pad++)data.push(pad%2?0x11:0xec);
  const mul=(x,y)=>{let z=0;for(let i=7;i>=0;i--){z=(z<<1)^(((z>>>7)&1)*0x11d);z^=((y>>>i)&1)*x}return z};
  let gen=[1];for(let i=0;i<eccCount;i++){const next=Array(gen.length+1).fill(0),root=(()=>{let v=1;for(let j=0;j<i;j++)v=mul(v,2);return v})();for(let j=0;j<gen.length;j++){next[j]^=gen[j];next[j+1]^=mul(gen[j],root)}gen=next}
  const blocks=[];for(let start=0;start<data.length;start+=108){const part=data.slice(start,start+108),ecc=Array(eccCount).fill(0);for(const b of part){const factor=b^ecc.shift();ecc.push(0);for(let j=0;j<eccCount;j++)ecc[j]^=mul(gen[j+1],factor)}blocks.push({part,ecc})}
  const words=[];for(let i=0;i<108;i++)for(const block of blocks)words.push(block.part[i]);for(let i=0;i<eccCount;i++)for(const block of blocks)words.push(block.ecc[i]);
  const stream=[];for(const w of words)for(let i=7;i>=0;i--)stream.push((w>>>i)&1);
  const grid=Array.from({length:size},()=>Array(size).fill(false)),func=Array.from({length:size},()=>Array(size).fill(false));
  const set=(x,y,dark)=>{if(x>=0&&y>=0&&x<size&&y<size){grid[y][x]=!!dark;func[y][x]=true}};
  for(let i=0;i<size;i++){set(6,i,i%2===0);set(i,6,i%2===0)}
  const finder=(cx,cy)=>{for(let dy=-4;dy<=4;dy++)for(let dx=-4;dx<=4;dx++){const d=Math.max(Math.abs(dx),Math.abs(dy));set(cx+dx,cy+dy,d===3||d<=1)}};
  finder(3,3);finder(size-4,3);finder(3,size-4);
  // Version 5 has one alignment pattern: the other position pairs overlap finder patterns.
  for(const [cx,cy] of [[30,30]])for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++)set(cx+dx,cy+dy,Math.max(Math.abs(dx),Math.abs(dy))!==1);
  // Reserve both format-information areas before placing data modules.
  for(let i=0;i<=5;i++)set(8,i,false);set(8,7,false);set(8,8,false);set(7,8,false);for(let i=9;i<15;i++)set(14-i,8,false);
  for(let i=0;i<8;i++)set(size-1-i,8,false);for(let i=8;i<15;i++)set(8,size-15+i,false);
  const mask=0;let bit=0,up=true;
  for(let right=size-1;right>=1;right-=2){if(right===6)right=5;for(let k=0;k<size;k++){const y=up?size-1-k:k;for(let side=0;side<2;side++){const x=right-side;if(func[y][x])continue;let dark=bit<stream.length?stream[bit++]===1:false;if((x+y)%2===0)dark=!dark;grid[y][x]=dark}}up=!up}
  const formatData=(1<<3)|mask;let rem=formatData<<10;for(let i=14;i>=10;i--)if((rem>>>i)&1)rem^=0x537<<(i-10);const format=((formatData<<10)|rem)^0x5412;
  for(let i=0;i<=5;i++)set(8,i,(format>>>i)&1);set(8,7,(format>>>6)&1);set(8,8,(format>>>7)&1);set(7,8,(format>>>8)&1);for(let i=9;i<15;i++)set(14-i,8,(format>>>i)&1);
  for(let i=0;i<8;i++)set(size-1-i,8,(format>>>i)&1);for(let i=8;i<15;i++)set(8,size-15+i,(format>>>i)&1);set(8,size-8,true);
  let path='';for(let y=0;y<size;y++)for(let x=0;x<size;x++)if(grid[y][x])path+='M'+(x+4)+' '+(y+4)+'h1v1h-1z';
  return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+(size+8)+' '+(size+8)+'" width="360" height="360" shape-rendering="crispEdges" role="img" aria-label="Authenticator QR-code"><rect width="100%" height="100%" fill="#fff"/><path d="'+path+'" fill="#000"/></svg>';
}
function showQr(id,account,secret){$(id).innerHTML=qrSvg(otpauthUri(account,secret))}
function formatOtpInput(input){input.addEventListener('input',()=>{const value=input.value,digits=value.replace(/\D/g,'');if(/^[\d-]*$/.test(value)&&digits.length<=6&&digits.length>0)input.value=digits.length>3?digits.slice(0,3)+'-'+digits.slice(3):digits})}
formatOtpInput($('mfaCode'));formatOtpInput($('setupCode'));
function closeMobileMenu(){$('sidebar').classList.remove('sidebar-open');$('menuBackdrop').classList.remove('open');$('menuToggle').setAttribute('aria-expanded','false')}function setView(view){const names={overview:'Overzicht',customers:'Klanten',licenses:'Licenties',support:'Support'},section=$('view-'+view);if(!section)return;document.querySelectorAll('.admin-view').forEach(item=>item.classList.toggle('hidden',item!==section));document.querySelectorAll('.nav-item[data-view]').forEach(button=>{const active=button.dataset.view===view;button.classList.toggle('active',active);if(active)button.setAttribute('aria-current','page');else button.removeAttribute('aria-current')});$('pageTitle').textContent=names[view];$('mobilePageTitle').textContent=names[view];closeMobileMenu();window.scrollTo({top:0,behavior:'smooth'});if(view==='support')loadSupportTickets().catch(e=>$('supportTicketError').textContent=e.message)}function updateOverview(){$('statCustomers').textContent=customers.length;$('statLicenses').textContent=licenseSummary.licenses;$('statGroups').textContent=licenseSummary.groups}document.querySelectorAll('.nav-item[data-view]').forEach(button=>button.onclick=()=>setView(button.dataset.view));document.querySelectorAll('[data-go-view]').forEach(button=>button.onclick=()=>setView(button.dataset.goView));$('goIssueLicense').onclick=()=>{setView('licenses');$('issueLicensePanel').classList.remove('hidden');$('label').focus()};$('menuToggle').onclick=()=>{const open=!$('sidebar').classList.contains('sidebar-open');$('sidebar').classList.toggle('sidebar-open',open);$('menuBackdrop').classList.toggle('open',open);$('menuToggle').setAttribute('aria-expanded',String(open))};$('menuBackdrop').onclick=closeMobileMenu;document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMobileMenu()});$('showIssueLicense').onclick=()=>{$('issueLicensePanel').classList.remove('hidden');$('label').focus()};$('cancelIssueLicense').onclick=()=>{$('issueLicensePanel').classList.add('hidden');$('createError').textContent=''};$('addStaff').onclick=()=>{$('staffCreatePanel').classList.remove('hidden');$('staffError').textContent='';$('staffName').focus()};$('cancelStaff').onclick=()=>{$('staffCreatePanel').classList.add('hidden');$('staffName').value='';$('staffUsername').value='';$('staffTemporaryPassword').value='';$('staffError').textContent=''};function showLogin(message=''){$('portalHeader').classList.remove('hidden');$('login').classList.remove('hidden');$('loginMfa').classList.add('hidden');$('bootstrap').classList.add('hidden');$('mfaSetup').classList.add('hidden');$('dashboard').classList.add('hidden');$('loginError').textContent=message}
async function enterDashboard(){const me=await api('/api/admin/me');role=me.role;['login','loginMfa','bootstrap','mfaSetup','portalHeader'].forEach(id=>$(id).classList.add('hidden'));$('dashboard').classList.remove('hidden');$('customerForm').classList.add('hidden');$('customerActions').classList.toggle('hidden',role!=='owner');$('staffPanel').classList.toggle('hidden',role!=='owner');$('supportNav').classList.toggle('hidden',role!=='owner');document.querySelectorAll('.owner-shortcut').forEach(item=>item.classList.toggle('hidden',role!=='owner'));$('issueLicensePanel').classList.add('hidden');$('staffCreatePanel').classList.add('hidden');setView('overview');await Promise.all([loadLicenses(),loadCustomers(),role==='owner'?loadStaff():Promise.resolve()])}
async function loadCustomers(){const body=$('customers');body.innerHTML='<tr><td colspan="6" class="muted">Laden…</td></tr>';try{const d=await api('/api/admin/customers');customers=d.customers;updateOverview();$('customerSelect').innerHTML='<option value="">Cohentra / intern</option>'+customers.filter(c=>c.status==='active'&&Number(c.product_enabled)===1).map(c=>'<option value="'+safe(c.id)+'">'+safe(c.name)+' · '+safe(c.licenses_in_use)+'/'+safe(c.max_licenses)+'</option>').join('');body.innerHTML=customers.length?customers.map(c=>'<tr><td>'+safe(c.name)+(c.portal_username?'<br><span class="muted">Portaal: '+safe(c.portal_username)+(c.portal_active?'':' (uitgeschakeld)')+'</span>':'<br><span class="muted">Nog geen portaalaccount</span>')+'</td><td>'+safe(c.contact_name||'—')+'<br><span class="muted">'+safe(c.contact_email||'')+'</span></td><td>'+safe(c.licenses_in_use||0)+' / '+safe(c.max_licenses??0)+'</td><td>'+safe((c.allowed_license_types||[]).map(t=>t==='admin'?'Beheerder':'Gesloten beta').join(', '))+'</td><td>'+safe(c.status==='active'?'Actief':'Gepauzeerd')+'</td><td>'+(role==='owner'?'<button class="secondary" data-portal="'+safe(c.id)+'">'+(c.portal_username?'Instellink opnieuw sturen':'Uitnodiging sturen')+'</button> <button class="secondary" data-customer-edit="'+safe(c.id)+'">Instellen</button> <button class="'+(c.status==='active'?'danger':'secondary')+'" data-customer-toggle="'+safe(c.id)+'">'+(c.status==='active'?'Pauzeren':'Hervatten')+'</button>':'')+'</td></tr>').join(''):'<tr><td colspan="6" class="muted">Nog geen klanten.</td></tr>';updateLicenseTypes()}catch(e){body.innerHTML='<tr><td colspan="6" class="error">'+safe(e.message)+'</td></tr>'}}
function editCustomer(c=null){$('customerId').value=c?.id||'';$('customerName').value=c?.name||'';$('customerContact').value=c?.contact_name||'';$('customerEmail').value=c?.contact_email||'';$('customerNotes').value=c?.notes||'';$('customerLimit').value=c?.max_licenses??5;$('allowBeta').checked=!c||c.allowed_license_types?.includes('beta');$('allowAdmin').checked=!!c?.allowed_license_types?.includes('admin');$('customerError').textContent='';$('customerForm').classList.remove('hidden');$('customerForm').scrollIntoView({behavior:'smooth',block:'center'});$('customerName').focus()}
$('addCustomer').onclick=()=>editCustomer();$('cancelCustomer').onclick=()=>{$('customerForm').reset();$('customerId').value='';$('customerForm').classList.add('hidden')};
$('customerForm').onsubmit=async e=>{e.preventDefault();const id=$('customerId').value,button=$('saveCustomer'),types=[];if($('allowBeta').checked)types.push('beta');if($('allowAdmin').checked)types.push('admin');button.disabled=true;$('customerError').textContent='';try{await api(id?'/api/admin/customers/'+encodeURIComponent(id):'/api/admin/customers',{method:id?'PATCH':'POST',body:JSON.stringify({name:$('customerName').value.trim(),contact_name:$('customerContact').value.trim(),contact_email:$('customerEmail').value.trim(),notes:$('customerNotes').value.trim(),max_licenses:Number($('customerLimit').value),allowed_license_types:types})});$('customerForm').classList.add('hidden');$('customerForm').reset();$('customerId').value='';await loadCustomers()}catch(err){$('customerError').textContent=err.message}finally{button.disabled=false}};
$('customers').onclick=async e=>{const portal=e.target.dataset.portal,edit=e.target.dataset.customerEdit,toggle=e.target.dataset.customerToggle;if(portal){const b=e.target;b.disabled=true;try{const d=await api('/api/admin/customers/'+encodeURIComponent(portal)+'/portal-account',{method:'POST',body:'{}'});const out=$('portalCredentials');out.textContent='Beveiligde accountlink verstuurd naar '+d.email+'. Bestaande accountgegevens en wachtwoord blijven ongewijzigd totdat de klant de link gebruikt. De link is eenmalig geldig gedurende één uur.';out.classList.remove('hidden');out.scrollIntoView({behavior:'smooth',block:'center'});await loadCustomers()}catch(err){alert(err.message)}finally{b.disabled=false}return}if(edit){const c=customers.find(x=>x.id===edit);if(c)editCustomer(c);return}if(toggle){const c=customers.find(x=>x.id===toggle);if(!c)return;const pause=c.status==='active';if(!confirm(pause?'Klant pauzeren? Bestaande klantlicenties kunnen dan niet meer valideren.':'Klanttoegang hervatten?'))return;try{await api('/api/admin/customers/'+encodeURIComponent(toggle)+'/'+(pause?'pause':'resume'),{method:'POST',body:'{}'});await Promise.all([loadCustomers(),loadLicenses()])}catch(err){alert(err.message)}}};
function renderSupportTickets(){const body=$('supportTickets'),statusFilter=$('supportStatusFilter').value,sourceFilter=$('supportSourceFilter').value;const rows=supportTicketRows.filter(t=>(statusFilter==='all'||t.status===statusFilter)&&(sourceFilter==='all'||(sourceFilter==='website'?t.source==='website':t.source!=='website')));const statuses={new:'Nieuw',in_progress:'In behandeling',waiting_customer:'Wacht op klant',closed:'Afgerond'},types={maatwerksoftware:'Software op maat',procesautomatisering:'Procesautomatisering',website:'Website op maat',overig:'Verkennend gesprek'};body.innerHTML=rows.length?rows.map(t=>'<tr><td><button type="button" class="secondary" data-open-ticket="'+safe(t.id)+'"><strong>'+safe(t.reference)+'</strong></button></td><td>'+safe(t.customer_name||'—')+(t.organization?'<br><span class="muted">'+safe(t.organization)+'</span>':'')+'<br><a href="mailto:'+encodeURIComponent(t.contact_email||'')+'">'+safe(t.contact_email||'Geen e-mailadres')+'</a></td><td><button type="button" class="ticket-subject" data-open-ticket="'+safe(t.id)+'">'+safe(t.subject)+'</button><div class="muted" style="white-space:pre-wrap;max-width:480px;max-height:100px;overflow:auto">'+safe(t.message)+'</div></td><td>'+safe(t.source==='website'?'Inzending contactformulier · '+(types[t.request_type]||'Aanvraag'):'Klantenportaal')+'</td><td>'+safe(new Date(t.created_at).toLocaleString('nl-NL'))+'</td><td><div style="display:grid;gap:6px;min-width:150px"><select data-ticket-status="'+safe(t.id)+'">'+Object.entries(statuses).map(([key,label])=>'<option value="'+key+'" '+(t.status===key?'selected':'')+'>'+label+'</option>').join('')+'</select><button type="button" class="secondary" data-ticket-save="'+safe(t.id)+'">Status opslaan</button></div></td></tr>').join(''):'<tr><td colspan="6" class="muted">Geen tickets gevonden voor deze filters.</td></tr>'}
async function loadSupportTickets(){const body=$('supportTickets');body.innerHTML='<tr><td colspan="6" class="muted">Laden…</td></tr>';try{const d=await api('/api/support/tickets');supportTicketRows=d.tickets;renderSupportTickets();$('supportTicketError').textContent=''}catch(e){body.innerHTML='<tr><td colspan="6" class="error">'+safe(e.message)+'</td></tr>'}}
$('supportStatusFilter').onchange=renderSupportTickets;$('supportSourceFilter').onchange=renderSupportTickets;
$('refreshSupport').onclick=()=>loadSupportTickets().catch(e=>$('supportTicketError').textContent=e.message);
let currentSupportTicketId='';function renderSupportReplies(ticket,replies){const items=[{author_name:ticket.customer_name||'Klant',author_email:ticket.contact_email,message:ticket.message,created_at:ticket.created_at,delivery_status:'received'},...replies];$('supportConversation').innerHTML=items.map(item=>'<article class="conversation-message '+(item.delivery_status==='received'?'customer-message':'support-message')+'"><div class="conversation-meta"><strong>'+safe(item.author_name||'Cohentra Support')+'</strong><span>'+safe(item.author_email||'')+' · '+safe(new Date(item.created_at).toLocaleString('nl-NL'))+'</span></div><div class="conversation-text">'+safe(item.message)+'</div>'+(item.delivery_status==='failed'?'<p class="error">E-mail niet verstuurd</p>':item.delivery_status==='sent'?'<p class="sent-label">Verstuurd vanuit support@cohentra.digital</p>':'')+'</article>').join('')}
async function openSupportTicket(id){currentSupportTicketId=id;$('supportDetailError').textContent='';$('supportReplyForm').reset();$('supportReplyButton').disabled=true;$('supportConversation').innerHTML='<p class="muted">Gesprek laden…</p>';$('supportTicketDialog').showModal();try{const d=await api('/api/support/tickets/'+encodeURIComponent(id));const t=d.ticket;$('supportDetailTitle').textContent=t.subject;$('supportDetailMeta').innerHTML='<strong>'+safe(t.reference)+'</strong> · '+safe(t.customer_name||'—')+' · <a href="mailto:'+encodeURIComponent(t.contact_email||'')+'">'+safe(t.contact_email||'Geen e-mailadres')+'</a> · '+safe(new Date(t.created_at).toLocaleString('nl-NL'));$('supportReplyButton').disabled=!t.contact_email;renderSupportReplies(t,d.replies||[])}catch(err){$('supportConversation').innerHTML='<p class="error">'+safe(err.message)+'</p>'}}
$('supportTickets').onclick=async e=>{const open=e.target.closest('[data-open-ticket]')?.dataset.openTicket;if(open){openSupportTicket(open);return}const id=e.target.dataset.ticketSave;if(!id)return;const status=$('supportTickets').querySelector('[data-ticket-status="'+CSS.escape(id)+'"]').value;e.target.disabled=true;$('supportTicketError').textContent='';try{await api('/api/support/tickets/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify({status})});await loadSupportTickets()}catch(err){$('supportTicketError').textContent=err.message}finally{e.target.disabled=false}};
$('supportReplyForm').onsubmit=async e=>{e.preventDefault();if(!currentSupportTicketId)return;$('supportReplyButton').disabled=true;$('supportDetailError').textContent='';try{await api('/api/support/tickets/'+encodeURIComponent(currentSupportTicketId)+'/replies',{method:'POST',body:JSON.stringify({message:$('supportReplyMessage').value})});$('supportReplyForm').reset();const d=await api('/api/support/tickets/'+encodeURIComponent(currentSupportTicketId));renderSupportReplies(d.ticket,d.replies||[]);await loadSupportTickets()}catch(err){$('supportDetailError').textContent=err.message;try{const d=await api('/api/support/tickets/'+encodeURIComponent(currentSupportTicketId));renderSupportReplies(d.ticket,d.replies||[])}catch{}}finally{$('supportReplyButton').disabled=false}};
$('closeSupportTicket').onclick=$('cancelSupportReply').onclick=()=>$('supportTicketDialog').close();$('supportTicketDialog').onclick=e=>{if(e.target===$('supportTicketDialog'))$('supportTicketDialog').close()};

async function loadStaff(){try{const d=await api('/api/admin/staff');$('staff').innerHTML=d.staff.length?d.staff.map(s=>'<tr><td>'+safe(s.name)+'</td><td>'+safe(new Date(s.created_at).toLocaleDateString('nl-NL'))+'</td><td>'+safe(s.last_seen_at?new Date(s.last_seen_at).toLocaleString('nl-NL'):'—')+'</td><td>'+safe(s.revoked_at?'Ingetrokken':s.must_change_password?'Wachtwoord wijzigen bij eerste aanmelding':'Actief')+'</td><td>'+(!s.revoked_at?'<button class="danger" data-staff-revoke="'+safe(s.id)+'">Intrekken</button>':'')+'</td></tr>').join(''):'<tr><td colspan="5" class="muted">Nog geen supportaccounts.</td></tr>'}catch(e){$('staff').innerHTML='<tr><td colspan="5" class="error">'+safe(e.message)+'</td></tr>'}}
$('createStaff').onclick=async()=>{const button=$('createStaff');button.disabled=true;$('staffError').textContent='';$('staffKey').classList.add('hidden');try{const d=await api('/api/admin/staff',{method:'POST',body:JSON.stringify({name:$('staffName').value.trim(),username:$('staffUsername').value.trim(),temporary_password:$('staffTemporaryPassword').value})});$('staffKey').innerHTML='<strong>Deel deze eenmalige accountgegevens, QR-koppeling en herstelcodes veilig en persoonlijk. Het wachtwoord wordt hierna niet opnieuw getoond.</strong><p>Gebruikersnaam: <span class="key">'+safe(d.username)+'</span><br>Tijdelijk wachtwoord: <span class="key">'+safe(d.password)+'</span></p><div id="staffQr" class="notice" style="width:max-content;max-width:100%;margin:12px auto"></div><p>Handmatige sleutel: <span class="key">'+safe(d.totp_secret)+'</span></p><strong>Herstelcodes</strong><p>'+d.recovery_codes.map(safe).join('<br>')+'</p>';$('staffKey').classList.remove('hidden');showQr('staffQr',d.username,d.totp_secret);$('staffName').value='';$('staffUsername').value='';$('staffTemporaryPassword').value='';$('staffCreatePanel').classList.add('hidden');await loadStaff()}catch(e){$('staffError').textContent=e.message}finally{button.disabled=false}};
$('staff').onclick=async e=>{const id=e.target.dataset.staffRevoke;if(!id)return;if(!confirm('Deze supportcode direct intrekken?'))return;try{await api('/api/admin/staff/'+encodeURIComponent(id)+'/revoke',{method:'POST',body:'{}'});await loadStaff()}catch(err){alert(err.message)}};
async function loadLicenses(){const body=$('licenses');body.innerHTML='<p class="muted">Laden…</p>';try{const d=await api('/api/admin/licenses');licenseSummary={licenses:d.licenses.length,groups:d.groups.length};updateOverview();const options='<option value="">Geen groep</option>'+d.groups.map(g=>'<option value="'+safe(g.id)+'">'+safe(g.name)+'</option>').join('');$('group').innerHTML=options;$('bulkGroup').innerHTML=options;$('bulkControls').classList.add('hidden');$('groups').innerHTML=d.groups.length?d.groups.map(g=>'<tr><td>'+safe(g.name)+'</td><td>'+safe(g.license_count)+'</td><td><button class="secondary" data-group-rename="'+safe(g.id)+'" data-group-name="'+safe(g.name)+'">Hernoemen</button> <button class="danger" data-group-delete="'+safe(g.id)+'">Verwijderen</button></td></tr>').join(''):'<tr><td colspan="3" class="muted">Nog geen groepen.</td></tr>';if(!d.licenses.length){body.innerHTML='<p class="muted">Nog geen actieve licenties.</p>';return}const buckets=new Map(d.groups.map(g=>[g.id,{name:g.name,items:[]} ]));buckets.set('',{name:'Geen groep',items:[]});for(const x of d.licenses)(buckets.get(x.group_id||'')||buckets.get('')).items.push(x);const cols='<thead><tr><th>Selecteer</th><th>Klant</th><th>Naam</th><th>Type</th><th>Geldig vanaf</th><th>Geldig tot</th><th>Client</th><th>Activatiedatum</th><th>Laatst online actief</th><th>Status</th><th></th></tr></thead>';const row=x=>'<tr><td><input type="checkbox" class="license-select" value="'+safe(x.id)+'" aria-label="Selecteer '+safe(x.label||'licentie')+'"></td><td>'+safe(x.customer_name||'Cohentra / intern')+'</td><td>'+(safe(x.label)||'<span class="muted">—</span>')+'</td><td>'+safe(x.license_type)+'</td><td>'+safe(x.valid_from)+'</td><td>'+safe(x.valid_until)+'</td><td>'+safe(x.activated_at?'Gekoppeld':'Vrij')+'</td><td>'+safe(x.activated_at?new Date(x.activated_at).toLocaleDateString('nl-NL'):'—')+'</td><td>'+safe(x.last_seen_at?new Date(x.last_seen_at).toLocaleString('nl-NL'):'—')+'</td><td>'+safe(x.status)+'</td><td><details class="actions-menu"><summary aria-label="Acties">…</summary><div class="menu-items"><button type="button" data-rename="'+safe(x.id)+'" data-label="'+safe(x.label)+'">Naam wijzigen</button>'+(x.activated_at?'<button type="button" data-reset="'+safe(x.id)+'">Reset client</button>':'')+'<button type="button" class="menu-danger" data-revoke="'+safe(x.id)+'">Intrekken</button></div></details></td></tr>';body.innerHTML=[...buckets.entries()].filter(([,b])=>b.items.length).map(([id,b])=>'<details class="license-group" open><summary>'+safe(b.name)+' <span class="muted">('+b.items.length+')</span></summary><div class="table-wrap"><table>'+cols+'<tbody>'+b.items.map(row).join('')+'</tbody></table></div></details>').join('')}catch(e){body.innerHTML='<p class="error">'+safe(e.message)+'</p>'}}
function updateLicenseTypes(){const selected=customers.find(c=>c.id===$('customerSelect').value),allowed=selected?selected.allowed_license_types:['beta','admin'];for(const option of $('type').options)option.hidden=!allowed.includes(option.value);if(!allowed.includes($('type').value))$('type').value=allowed[0]||'beta';$('customerSelect').required=role==='support';$('count').max=selected?Math.max(1,Number(selected.max_licenses)-Number(selected.licenses_in_use||0)):100;$('count').disabled=!!selected&&Number(selected.max_licenses)<=Number(selected.licenses_in_use||0);if($('count').disabled)$('createError').textContent='De klant heeft het maximale aantal licenties in gebruik.';else if($('createError').textContent.includes('maximale aantal'))$('createError').textContent='';updateType()}
$('customerSelect').onchange=updateLicenseTypes;
$('loginBtn').onclick=async()=>{const button=$('loginBtn'),username=$('username').value.trim(),password=$('password').value;$('loginError').textContent='';button.disabled=true;try{const r=await fetch('/api/auth/challenge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username,password})});const d=await r.json();if(d.enrollment_required){$('bootstrap').classList.remove('hidden');$('login').classList.add('hidden');$('ownerUsername').value=username;$('ownerPassword').value=password;return}if(!r.ok)throw Error(d.error||'Gebruikersnaam of wachtwoord onjuist.');pendingChallenge=d.challenge_token;$('mfaUsername').textContent=username;$('mfaCode').value='';$('login').classList.add('hidden');$('loginMfa').classList.remove('hidden');$('mfaCode').focus()}catch(e){$('loginError').textContent=e.message}finally{button.disabled=false}};
$('verifyMfa').onclick=async()=>{const button=$('verifyMfa'),code=$('mfaCode').value.trim();button.disabled=true;$('mfaLoginError').textContent='';try{const body={challenge_token:pendingChallenge};if(/^\d{3}-\d{3}$/.test(code))body.mfa_code=code.replace('-','');else body.recovery_code=code;const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw Error(d.error||'Authenticatorcode onjuist.');pendingChallenge='';token=d.session_token;sessionStorage.setItem('eventhub-admin-token',token);await enterDashboard()}catch(e){$('mfaLoginError').textContent=e.message}finally{button.disabled=false}};
$('backToCredentials').onclick=async()=>{if(pendingChallenge)try{await fetch('/api/auth/logout',{method:'POST',headers:{'Authorization':'Bearer '+pendingChallenge}})}catch{}pendingChallenge='';$('loginMfa').classList.add('hidden');$('login').classList.remove('hidden');$('mfaCode').value='';$('password').focus()};
$('showSetup').onclick=()=>{$('bootstrap').classList.remove('hidden');$('login').classList.add('hidden');$('bootstrapError').textContent=''};$('cancelSetup').onclick=()=>showLogin();
$('beginSetup').onclick=async()=>{const button=$('beginSetup');button.disabled=true;$('bootstrapError').textContent='';try{const r=await fetch('/api/auth/mfa/setup',{method:'POST',headers:{'Authorization':'Bearer '+$('bootstrapToken').value,'Content-Type':'application/json'},body:JSON.stringify({username:$('ownerUsername').value,password:$('ownerPassword').value})});const d=await r.json();if(!r.ok)throw Error(d.error||'2FA-instelling is mislukt.');$('mfaSecret').textContent=d.secret;showQr('mfaQr','Cohentra Admin',d.secret);$('bootstrap').classList.add('hidden');$('mfaSetup').classList.remove('hidden');$('setupError').textContent='';$('recoveryCodes').classList.add('hidden');$('finishSetup').classList.add('hidden')}catch(e){$('bootstrapError').textContent=e.message}finally{button.disabled=false}};
$('confirmMfa').onclick=async()=>{const button=$('confirmMfa');button.disabled=true;$('setupError').textContent='';try{const r=await fetch('/api/auth/mfa/confirm',{method:'POST',headers:{'Authorization':'Bearer '+$('bootstrapToken').value,'Content-Type':'application/json'},body:JSON.stringify({code:$('setupCode').value.trim()})});const d=await r.json();if(!r.ok)throw Error(d.error||'Code klopt niet.');$('recoveryCodes').innerHTML='<strong>Bewaar deze herstelcodes veilig. Iedere code werkt één keer.</strong><p>'+d.recovery_codes.map(safe).join('<br>')+'</p>'; $('recoveryCodes').classList.remove('hidden');$('confirmMfa').classList.add('hidden');$('finishSetup').classList.remove('hidden')}catch(e){$('setupError').textContent=e.message}finally{button.disabled=false}};
$('finishSetup').onclick=()=>{for(const id of ['bootstrapToken','ownerPassword','setupCode','password','mfaCode'])$(id).value='';$('ownerUsername').value='';$('finishSetup').classList.add('hidden');$('confirmMfa').classList.remove('hidden');showLogin('2FA is geactiveerd. Meld nu aan met je gebruikersnaam, wachtwoord en authenticatorcode.')};
$('logout').onclick=async()=>{try{await fetch('/api/auth/logout',{method:'POST',headers:authHeaders()})}catch{}token='';role='';sessionStorage.removeItem('eventhub-admin-token');$('password').value='';$('mfaCode').value='';showLogin()};$('refresh').onclick=()=>Promise.all([loadLicenses(),loadCustomers()]);
function updateType(){const admin=$('type').value==='admin';if(admin)$('unlimited').checked=true;$('unlimited').disabled=admin;$('until').disabled=admin||$('unlimited').checked}
$('type').onchange=updateType;$('unlimited').onchange=updateType;
$('createBtn').onclick=async()=>{const b=$('createBtn'),out=$('newKey');b.disabled=true;$('createError').textContent='';out.classList.add('hidden');try{const d=await api('/api/admin/licenses',{method:'POST',body:JSON.stringify({label:$('label').value.trim(),group_id:$('group').value||null,customer_id:$('customerSelect').value||null,product_id:'eventhub',count:Number($('count').value),license_type:$('type').value,valid_from:$('from').value,valid_until:$('until').value,unlimited:$('unlimited').checked})});const all=d.licenses.map(x=>x.label+': '+x.license_key).join('\n');out.innerHTML='<strong>Bewaar deze sleutels nu; ze worden hierna niet opnieuw getoond.</strong><div class="key-table-wrap"><table class="key-table"><thead><tr><th>Naam</th><th>Licentiesleutel</th></tr></thead><tbody>'+d.licenses.map(x=>'<tr><td>'+safe(x.label||'Licentie')+'</td><td class="key-value">'+safe(x.license_key)+'</td></tr>').join('')+'</tbody></table></div><button class="secondary key-copy" id="copyKey">Kopieer alle sleutels</button>';out.classList.remove('hidden');$('copyKey').onclick=()=>navigator.clipboard.writeText(all);$('label').value='';$('count').value='1';$('type').value=$('customerSelect').value?$('type').value:'beta';$('unlimited').checked=false;updateLicenseTypes();await Promise.all([loadLicenses(),loadCustomers()])}catch(e){$('createError').textContent=e.message}finally{b.disabled=false}};
$('licenses').onchange=e=>{if(e.target.matches('.license-select')){const count=$('licenses').querySelectorAll('.license-select:checked').length;$('selectedCount').textContent=count+' geselecteerd';$('bulkControls').classList.toggle('hidden',count===0)}};
$('bulkMove').onclick=async()=>{const ids=[...$('licenses').querySelectorAll('.license-select:checked')].map(x=>x.value);if(!ids.length)return;$('bulkMove').disabled=true;try{await api('/api/admin/licenses/group',{method:'POST',body:JSON.stringify({license_ids:ids,group_id:$('bulkGroup').value||null})});await loadLicenses()}catch(err){alert(err.message)}finally{$('bulkMove').disabled=false}};
$('clearSelection').onclick=()=>{$('licenses').querySelectorAll('.license-select:checked').forEach(x=>x.checked=false);$('bulkControls').classList.add('hidden')};
$('licenses').onclick=async e=>{const rename=e.target.dataset.rename;if(rename){const label=prompt('Nieuwe naam voor deze licentie:',e.target.dataset.label||'');if(label===null)return;try{await api('/api/admin/licenses/'+encodeURIComponent(rename)+'/label',{method:'POST',body:JSON.stringify({label})});await loadLicenses()}catch(err){alert(err.message)}return}const id=e.target.dataset.revoke||e.target.dataset.reset;if(!id)return;const reset=!!e.target.dataset.reset;if(!confirm(reset?'Deze licentie opnieuw beschikbaar maken voor een andere client?':'Deze licentie intrekken?'))return;try{await api('/api/admin/licenses/'+encodeURIComponent(id)+'/'+(reset?'reset-activation':'revoke'),{method:'POST',body:'{}'});await Promise.all([loadLicenses(),loadCustomers()])}catch(err){alert(err.message)}};
$('createGroup').onclick=()=>{$('groupName').value='';$('groupError').textContent='';$('groupDialog').showModal();$('groupName').focus()};$('cancelGroup').onclick=()=>$('groupDialog').close();$('groupForm').onsubmit=async e=>{e.preventDefault();const name=$('groupName').value.trim();if(!name){$('groupError').textContent='Vul een groepsnaam in.';return}const button=$('saveGroup');button.disabled=true;$('groupError').textContent='';try{await api('/api/admin/groups',{method:'POST',body:JSON.stringify({name})});$('groupDialog').close();await loadLicenses()}catch(err){$('groupError').textContent=err.message}finally{button.disabled=false}};
$('groups').onclick=async e=>{const rename=e.target.dataset.groupRename,del=e.target.dataset.groupDelete;if(rename){const name=prompt('Nieuwe groepsnaam:',e.target.dataset.groupName);if(name===null)return;try{await api('/api/admin/groups/'+encodeURIComponent(rename),{method:'PATCH',body:JSON.stringify({name})});await loadLicenses()}catch(err){alert(err.message)}return}if(del){if(!confirm('Deze groep verwijderen? De licenties blijven bestaan onder Geen groep.'))return;try{await api('/api/admin/groups/'+encodeURIComponent(del),{method:'DELETE'});await loadLicenses()}catch(err){alert(err.message)}}};
document.addEventListener('click',e=>{const current=e.target.closest('.actions-menu');document.querySelectorAll('.actions-menu[open]').forEach(menu=>{if(!menu.contains(e.target)||menu!==current)menu.open=false})});document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.actions-menu[open]').forEach(menu=>menu.open=false)});
if(token)enterDashboard().catch(e=>{token='';sessionStorage.removeItem('eventhub-admin-token');showLogin(e.message)});else showLogin();
</script></body></html>`;

const JSON_HEADERS = { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store" };
const UNLIMITED_UNTIL = "9999-12-31";
const WEBSITE_CONTACT_CUSTOMER_ID = "cohentra-website-intake";
const WEBSITE_REQUEST_TYPES = {
  maatwerksoftware: "Software op maat",
  procesautomatisering: "Procesautomatisering",
  website: "Website op maat",
  overig: "Verkennend gesprek"
};

function isIsoDate(value) {
  return /^\d{4}-\d{2}-\d{2}$/.test(value)
    && Number.isFinite(Date.parse(`${value}T00:00:00Z`))
    && new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value;
}

function json(data, status = 200) {
  return new Response(JSON.stringify(data), { status, headers: JSON_HEADERS });
}
async function sendSupportTicketEmail(env, ticket, agentReply = null) {
  const username = String(env.STRATO_SMTP_USER || "").trim();
  const password = String(env.STRATO_SMTP_PASSWORD || "");
  if (!username || !password || !/^[^\s<>@]+@[^\s<>@]+\.[^\s<>@]+$/.test(username)) return false;
  let socket;
  try {
    const isAgentReply = Boolean(agentReply);
    if (isAgentReply && username.toLowerCase() !== "support@cohentra.digital") return false;
    const to = isAgentReply ? String(ticket.contactEmail || "").trim() : "support@cohentra.digital";
    if (!/^[^\s<>@]+@[^\s<>@]+\.[^\s<>@]+$/.test(to)) return false;
    const safeHeader = (value) => String(value || "").replace(/[\r\n]+/g, " ").trim();
    const text = isAgentReply
      ? [`Beste ${ticket.customerName || "klant"},`, "", `We hebben je supportaanvraag ${ticket.reference} in behandeling genomen.`, "", agentReply.message, "", `Referentie: ${ticket.reference}`, "Cohentra Support"].join("\n")
      : [`Nieuwe supportaanvraag ${ticket.reference}`, `Bron: ${ticket.source === "website" ? "Websiteformulier" : "Klantenportaal"}`, `Klant: ${ticket.customerName}`, `E-mailadres: ${ticket.contactEmail}`, `Categorie: ${ticket.category}`, `Onderwerp: ${ticket.subject}`, "", ticket.message, "", "Open de supportinbox: https://support.cohentra.digital/"].join("\n");
    const replyTo = isAgentReply ? "support@cohentra.digital" : String(ticket.contactEmail || "").trim();
    const b64Utf8 = (value) => btoa(String.fromCharCode(...new TextEncoder().encode(value)));
    const encodeHeader = (value) => `=?UTF-8?B?${b64Utf8(value)}?=`;
    const wrapBase64 = (value) => value.match(/.{1,76}/g)?.join("\r\n") || "";
    const base64 = (value) => wrapBase64(b64Utf8(value));
    const subject = isAgentReply ? `Re: [${ticket.reference}] ${safeHeader(ticket.subject)}` : `[${ticket.reference}] ${safeHeader(ticket.subject)}`;
    const replyHeader = /^[^\s<>@]+@[^\s<>@]+\.[^\s<>@]+$/.test(replyTo) ? `Reply-To: <${replyTo}>` : "";
    const mime = [`From: ${encodeHeader("Cohentra Support")} <${username}>`, `To: <${to}>`, ...(replyHeader ? [replyHeader] : []), `Subject: ${encodeHeader(subject)}`, `Date: ${new Date().toUTCString()}`, `Message-ID: <${crypto.randomUUID()}@${username.split("@")[1]}>`, "MIME-Version: 1.0", 'Content-Type: text/plain; charset="UTF-8"', "Content-Transfer-Encoding: base64", "", base64(text), ""].join("\r\n");
    socket = connect({ hostname: "smtp.strato.de", port: 465 }, { secureTransport: "on" });
    const reader = socket.readable.getReader(), writer = socket.writable.getWriter(), decoder = new TextDecoder();
    let pending = "";
    const line = async () => { while (!pending.includes("\n")) { const chunk = await reader.read(); if (chunk.done) throw new Error("SMTP-verbinding gesloten."); pending += decoder.decode(chunk.value, { stream: true }); if (pending.length > 16384) throw new Error("SMTP-antwoord is te groot."); } const end = pending.indexOf("\n"), value = pending.slice(0, end).replace(/\r$/, ""); pending = pending.slice(end + 1); return value; };
    const reply = async (expected) => { let response = ""; for (let count = 0; count < 30; count += 1) { const current = await line(); response = current; const match = /^(\d{3})([ -])/.exec(current); if (!match) throw new Error("Ongeldig SMTP-antwoord."); if (match[2] === " ") { const status = Number(match[1]); if (!expected.includes(status)) throw new Error(`SMTP-server antwoordde met ${status}.`); return response; } } throw new Error("SMTP-server stuurde te veel antwoordregels."); };
    const command = async (value, expected) => { await writer.write(new TextEncoder().encode(`${value}\r\n`)); return reply(expected); };
    await reply([220]); await command("EHLO eventhub.cohentra.digital", [250]); await command("AUTH LOGIN", [334]); await command(b64Utf8(username), [334]); await command(b64Utf8(password), [235]); await command(`MAIL FROM:<${username}>`, [250]); await command(`RCPT TO:<${to}>`, [250, 251]); await command("DATA", [354]);
    const escapedMime = mime.replace(/(^|\r\n)\./g, "$1.."); await writer.write(new TextEncoder().encode(`${escapedMime}\r\n.\r\n`)); await reply([250]); await command("QUIT", [221]); writer.releaseLock(); reader.releaseLock(); return true;
  } catch (error) {
    console.error("support_ticket_email_failed", { reference: ticket.reference, message: String(error?.message || error).slice(0, 200) });
    return false;
  } finally { try { socket?.close(); } catch {} }
}
function constantTimeEqual(left, right) {
  const a = new TextEncoder().encode(String(left || "")), b = new TextEncoder().encode(String(right || ""));
  if (a.length !== b.length) return false;
  let difference = 0;
  for (let i = 0; i < a.length; i += 1) difference |= a[i] ^ b[i];
  return difference === 0;
}

function normalizedKey(value) {
  return String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
}

async function digest(value) {
  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

function createLicenseKey() {
  const bytes = crypto.getRandomValues(new Uint8Array(16));
  const raw = [...bytes].map((b) => b.toString(16).padStart(2, "0")).join("").toUpperCase();
  return `EH-${raw.match(/.{1,4}/g).join("-")}`;
}

async function adminAuthorized(request, env) {
  const match = /^Bearer\s+(.+)$/i.exec(request.headers.get("Authorization") || "");
  if (!match) return null;
  const tokenHash = await digest(match[1]);
  const session = await env.DB.prepare("SELECT ss.id, ss.staff_id, ss.actor_role AS role, st.name FROM staff_sessions ss LEFT JOIN staff_access_tokens st ON st.id = ss.staff_id WHERE ss.token_hash = ? AND ss.mfa_verified = 1 AND ss.password_change_only = 0 AND ss.revoked_at IS NULL AND ss.expires_at > ? AND (ss.staff_id IS NULL OR st.revoked_at IS NULL)").bind(tokenHash, Date.now()).first();
  if (!session) return null;
  const now = new Date().toISOString();
  await env.DB.prepare("UPDATE staff_sessions SET last_seen_at = ? WHERE id = ?").bind(now, session.id).run();
  if (session.staff_id) await env.DB.prepare("UPDATE staff_access_tokens SET last_seen_at = ? WHERE id = ?").bind(now, session.staff_id).run();
  return { id: session.staff_id, session_id: session.id, role: session.role, name: session.name || "Cohentra beheerder" };
}

async function customerAuthorized(request, env) {
  const match = /^Bearer\s+(.+)$/i.exec(request.headers.get("Authorization") || "");
  if (!match) return null;
  const now = Date.now(), tokenHash = await digest(match[1]);
  const account = await env.DB.prepare("SELECT s.id AS session_id, a.id AS account_id, a.username, a.customer_id, c.name AS customer_name, c.status AS customer_status, cp.max_licenses, cp.allowed_license_types, cp.enabled AS product_enabled, p.active AS product_active FROM customer_sessions s JOIN customer_portal_accounts a ON a.id = s.customer_account_id JOIN customers c ON c.id = a.customer_id JOIN customer_products cp ON cp.customer_id = c.id AND cp.product_id = 'eventhub' JOIN products p ON p.id = cp.product_id WHERE s.token_hash = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND a.active = 1 LIMIT 1").bind(tokenHash, now).first();
  if (!account || account.customer_status !== "active" || account.product_enabled !== 1 || account.product_active !== 1) return null;
  const timestamp = new Date().toISOString();
  await env.DB.batch([
    env.DB.prepare("UPDATE customer_sessions SET last_seen_at = ? WHERE id = ? AND revoked_at IS NULL").bind(timestamp, account.session_id),
    env.DB.prepare("UPDATE customer_portal_accounts SET last_seen_at = ? WHERE id = ? AND active = 1").bind(timestamp, account.account_id)
  ]);
  return { ...account, allowed_license_types: allowedLicenseTypes(account.allowed_license_types) };
}

async function issueCustomerSession(env, accountId) {
  const token = randomHex(32), now = Date.now(), timestamp = new Date(now).toISOString();
  await env.DB.prepare("INSERT INTO customer_sessions (id, token_hash, customer_account_id, created_at, expires_at, last_seen_at) VALUES (?, ?, ?, ?, ?, ?)").bind(crypto.randomUUID(), await digest(token), accountId, timestamp, now + 12 * 60 * 60 * 1000, timestamp).run();
  return token;
}

async function sendCustomerAuthEmail(env, accountId, email, purpose) {
  if (!env.EMAIL) throw new Error("De e-mailservice is niet beschikbaar.");
  const rawToken = randomHex(32), now = Date.now(), expiresAt = now + 60 * 60 * 1000;
  const tokenHash = await digest(rawToken);
  await env.DB.batch([
    env.DB.prepare("UPDATE customer_auth_tokens SET consumed_at = ? WHERE customer_account_id = ? AND purpose = ? AND consumed_at IS NULL").bind(now, accountId, purpose),
    env.DB.prepare("INSERT INTO customer_auth_tokens (token_hash, customer_account_id, purpose, expires_at, created_at) VALUES (?, ?, ?, ?, ?)").bind(tokenHash, accountId, purpose, expiresAt, now)
  ]);
  const flow = purpose === "invite" ? "invite" : "reset";
  const link = "https://customer.cohentra.digital/?flow=" + flow + "&token=" + rawToken;
  const subject = purpose === "invite" ? "Je Cohentra klantenportaal instellen" : "Wachtwoord herstellen voor Cohentra";
  const intro = purpose === "invite"
    ? "Er is een account voor je aangemaakt in het Cohentra klantenportaal. Stel via de beveiligde link je wachtwoord in."
    : "We hebben een verzoek ontvangen om het wachtwoord van je Cohentra klantenportaal te herstellen. Gebruik de beveiligde link om een nieuw wachtwoord te kiezen.";
  const html = '<div style="font-family:Arial,sans-serif;color:#17283a;line-height:1.6;max-width:560px;margin:auto"><p style="font-weight:800;letter-spacing:.12em">COHENTRA <span style="font-weight:400;letter-spacing:0">digital</span></p><h1 style="font-size:24px">' + subject + '</h1><p>' + intro + '</p><p><a href="' + link + '" style="display:inline-block;background:#1768a6;color:white;padding:12px 18px;border-radius:7px;text-decoration:none;font-weight:bold">' + (purpose === "invite" ? "Account instellen" : "Wachtwoord herstellen") + '</a></p><p>De link is één uur geldig en kan één keer worden gebruikt. Heb je dit niet aangevraagd? Dan kun je deze e-mail negeren.</p><p style="color:#66788b">Cohentra Digital · <a href="mailto:info@cohentra.digital">info@cohentra.digital</a></p></div>';
  const text = subject + "\n\n" + intro + "\n\nOpen deze beveiligde link (1 uur geldig, eenmalig): " + link + "\n\nHeb je dit niet aangevraagd? Negeer deze e-mail.\n\nCohentra Digital · info@cohentra.digital";
  await env.EMAIL.send({
    to: email,
    from: { email: "noreply@noreply.cohentra.digital", name: "Cohentra Digital" },
    replyTo: "info@cohentra.digital",
    subject,
    text,
    html
  });
}

async function recordCustomerAuthRequest(env, key, now) {
  await env.DB.prepare("INSERT INTO customer_auth_rate_limits (bucket_key, window_started_at, attempts) VALUES (?, ?, 1) ON CONFLICT(bucket_key) DO UPDATE SET attempts = CASE WHEN window_started_at <= ? THEN 1 ELSE attempts + 1 END, window_started_at = CASE WHEN window_started_at <= ? THEN excluded.window_started_at ELSE window_started_at END")
    .bind(key, now, now - 60 * 60 * 1000, now - 60 * 60 * 1000).run();
  const row = await env.DB.prepare("SELECT attempts FROM customer_auth_rate_limits WHERE bucket_key = ?").bind(key).first();
  return Number(row?.attempts || 0);
}

function allowedLicenseTypes(value) {
  try {
    const types = JSON.parse(String(value || "[]"));
    return Array.isArray(types) ? [...new Set(types.filter((type) => type === "beta" || type === "admin"))] : [];
  } catch {
    return [];
  }
}

const BASE32_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
function randomHex(bytes = 32) { return [...crypto.getRandomValues(new Uint8Array(bytes))].map((b) => b.toString(16).padStart(2, "0")).join(""); }
function encodeBase32(bytes) {
  let bits = 0, value = 0, output = "";
  for (const byte of bytes) { value = (value << 8) | byte; bits += 8; while (bits >= 5) { output += BASE32_ALPHABET[(value >>> (bits - 5)) & 31]; bits -= 5; } }
  if (bits) output += BASE32_ALPHABET[(value << (5 - bits)) & 31];
  return output;
}
function decodeBase32(value) {
  let bits = 0, buffer = 0; const output = [];
  for (const char of value.toUpperCase().replace(/=|\s/g, "")) { const digit = BASE32_ALPHABET.indexOf(char); if (digit < 0) throw new Error("Ongeldige TOTP-sleutel."); buffer = (buffer << 5) | digit; bits += 5; if (bits >= 8) { output.push((buffer >>> (bits - 8)) & 255); bits -= 8; } }
  return new Uint8Array(output);
}
async function encryptMfaSecret(secret, env) {
  if (!env.MFA_ENCRYPTION_KEY || env.MFA_ENCRYPTION_KEY.length < 32) throw new Error("De Worker-secret MFA_ENCRYPTION_KEY ontbreekt of is korter dan 32 tekens.");
  const keyBytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(env.MFA_ENCRYPTION_KEY));
  const key = await crypto.subtle.importKey("raw", keyBytes, "AES-GCM", false, ["encrypt"]);
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const encrypted = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, new TextEncoder().encode(secret));
  return `${[...iv].map((b) => b.toString(16).padStart(2, "0")).join("")}.${[...new Uint8Array(encrypted)].map((b) => b.toString(16).padStart(2, "0")).join("")}`;
}
async function decryptMfaSecret(value, env) {
  if (!env.MFA_ENCRYPTION_KEY || env.MFA_ENCRYPTION_KEY.length < 32) throw new Error("De Worker-secret MFA_ENCRYPTION_KEY ontbreekt of is korter dan 32 tekens.");
  const [ivHex, dataHex] = String(value || "").split(".");
  const fromHex = (hex) => Uint8Array.from(hex.match(/.{2}/g) || [], (b) => parseInt(b, 16));
  const keyBytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(env.MFA_ENCRYPTION_KEY));
  const key = await crypto.subtle.importKey("raw", keyBytes, "AES-GCM", false, ["decrypt"]);
  const plaintext = await crypto.subtle.decrypt({ name: "AES-GCM", iv: fromHex(ivHex) }, key, fromHex(dataHex));
  return new TextDecoder().decode(plaintext);
}
async function totpCounter(secret, code, now = Date.now(), lastCounter = -1) {
  if (!/^\d{6}$/.test(String(code || ""))) return null;
  const key = await crypto.subtle.importKey("raw", decodeBase32(secret), { name: "HMAC", hash: "SHA-1" }, false, ["sign"]);
  const current = Math.floor(now / 30000);
  for (const counter of [current - 1, current, current + 1]) {
    if (counter <= lastCounter) continue;
    const message = new Uint8Array(8); let n = counter;
    for (let i = 7; i >= 0; i -= 1) { message[i] = n & 255; n = Math.floor(n / 256); }
    const mac = new Uint8Array(await crypto.subtle.sign("HMAC", key, message));
    const offset = mac[mac.length - 1] & 15;
    const binary = ((mac[offset] & 127) << 24) | (mac[offset + 1] << 16) | (mac[offset + 2] << 8) | mac[offset + 3];
    if (String(binary % 1000000).padStart(6, "0") === code) return counter;
  }
  return null;
}
function makeRecoveryCode() { const value = randomHex(8).toUpperCase(); return `${value.slice(0, 4)}-${value.slice(4, 8)}-${value.slice(8, 12)}-${value.slice(12)}`; }
function normalizeRecoveryCode(value) { return String(value || "").replace(/[^A-Z0-9]/gi, "").toUpperCase(); }
async function createRecoveryCodes(env, ownerId, staffId) {
  const codes = Array.from({ length: 10 }, makeRecoveryCode); const now = new Date().toISOString();
  await env.DB.prepare("DELETE FROM mfa_recovery_codes WHERE owner_id IS ? AND staff_id IS ?").bind(ownerId, staffId).run();
  for (const code of codes) await env.DB.prepare("INSERT INTO mfa_recovery_codes (id, owner_id, staff_id, code_hash, created_at) VALUES (?, ?, ?, ?, ?)").bind(crypto.randomUUID(), ownerId, staffId, await digest(normalizeRecoveryCode(code)), now).run();
  return codes;
}
async function issueSession(env, role, staffId = null) {
  const token = randomHex(32); const id = crypto.randomUUID(); const now = new Date().toISOString();
  await env.DB.prepare("INSERT INTO staff_sessions (id, token_hash, staff_id, actor_role, created_at, expires_at, last_seen_at) VALUES (?, ?, ?, ?, ?, ?, ?)").bind(id, await digest(token), staffId, role, now, Date.now() + 12 * 60 * 60 * 1000, now).run();
  return token;
}
async function hashPassword(password, saltHex = randomHex(16)) {
  const salt = Uint8Array.from(saltHex.match(/.{2}/g) || [], (b) => parseInt(b, 16));
  const material = await crypto.subtle.importKey("raw", new TextEncoder().encode(password), "PBKDF2", false, ["deriveBits"]);
  // Cloudflare Workers currently rejects PBKDF2 deriveBits requests above 100,000 iterations.
  const bits = await crypto.subtle.deriveBits({ name: "PBKDF2", salt, iterations: 100000, hash: "SHA-256" }, material, 256);
  return { salt: saltHex, hash: [...new Uint8Array(bits)].map((b) => b.toString(16).padStart(2, "0")).join("") };
}
async function passwordMatches(password, salt, expectedHash) {
  if (!salt || !expectedHash) return false;
  const actual = await hashPassword(password, salt);
  return actual.hash === expectedHash;
}
async function consumeRecoveryCode(env, code, ownerId, staffId) {
  if (!code) return false;
  const row = await env.DB.prepare("SELECT id FROM mfa_recovery_codes WHERE code_hash = ? AND owner_id IS ? AND staff_id IS ? AND used_at IS NULL").bind(await digest(normalizeRecoveryCode(code)), ownerId, staffId).first();
  if (!row) return false;
  const result = await env.DB.prepare("UPDATE mfa_recovery_codes SET used_at = ? WHERE id = ? AND used_at IS NULL").bind(new Date().toISOString(), row.id).run();
  return result.meta?.changes === 1;
}
async function recordLoginFailure(env, key) {
  const now = Date.now(); const row = await env.DB.prepare("SELECT failures, window_started_at FROM auth_login_attempts WHERE login_key = ?").bind(key).first();
  const failures = !row || now - row.window_started_at > 15 * 60 * 1000 ? 1 : row.failures + 1;
  await env.DB.prepare("INSERT INTO auth_login_attempts (login_key, failures, window_started_at, locked_until) VALUES (?, ?, ?, ?) ON CONFLICT(login_key) DO UPDATE SET failures = excluded.failures, window_started_at = excluded.window_started_at, locked_until = excluded.locked_until").bind(key, failures, !row || now - row.window_started_at > 15 * 60 * 1000 ? now : row.window_started_at, failures >= 5 ? now + 15 * 60 * 1000 : null).run();
}

async function readJson(request, maxLength = 8192) {
  const length = Number(request.headers.get("Content-Length") || 0);
  if (length > maxLength) throw new Error("Aanvraag is te groot.");
  return await request.json();
}

function contactCorsHeaders() {
  return {
    "Access-Control-Allow-Origin": "https://cohentra.digital",
    "Access-Control-Allow-Methods": "POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Max-Age": "600",
    "Vary": "Origin"
  };
}

function contactJson(data, status = 200) {
  return new Response(JSON.stringify(data), { status, headers: { ...JSON_HEADERS, ...contactCorsHeaders() } });
}

function contactFormPage(message, status = 200) {
  const safeMessage = String(message).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character]);
  const html = `<!doctype html><html lang="nl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080914"><title>Contact · Cohentra Digital</title><body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#080914;color:#f5f6ff;font:16px/1.7 system-ui,sans-serif"><main style="max-width:560px;padding:40px 28px;text-align:center"><p style="color:#62d9ef;font-size:12px;letter-spacing:.15em;text-transform:uppercase">Cohentra Digital</p><h1 style="font-size:clamp(32px,7vw,54px);line-height:1.08">${safeMessage}</h1><a style="display:inline-block;margin-top:18px;padding:12px 19px;border-radius:99px;background:linear-gradient(112deg,#9236ef,#455fff 65%,#22bfdf);color:white;text-decoration:none;font-weight:700" href="https://cohentra.digital/#contact">Terug naar Cohentra</a></main></body></html>`;
  return new Response(html, { status, headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff", "Referrer-Policy": "no-referrer" } });
}

async function readContactBody(request) {
  const declaredLength = Number(request.headers.get("Content-Length") || 0);
  if (declaredLength > 8192) throw new Error("Aanvraag is te groot.");
  const reader = request.body?.getReader();
  if (!reader) return {};
  const chunks = [];
  let totalLength = 0;
  try {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      totalLength += value.byteLength;
      if (totalLength > 8192) {
        try { await reader.cancel(); } catch {}
        throw new Error("Aanvraag is te groot.");
      }
      chunks.push(value);
    }
  } finally {
    reader.releaseLock();
  }
  const bytes = new Uint8Array(totalLength);
  let offset = 0;
  for (const chunk of chunks) {
    bytes.set(chunk, offset);
    offset += chunk.byteLength;
  }
  const raw = new TextDecoder().decode(bytes);
  const contentType = (request.headers.get("Content-Type") || "").split(";", 1)[0].trim().toLowerCase();
  if (contentType === "application/json") return JSON.parse(raw);
  if (contentType === "application/x-www-form-urlencoded") return Object.fromEntries(new URLSearchParams(raw));
  throw new Error("Ongeldig aanvraagformaat.");
}

async function handlePublicContact(request, env) {
  const origin = request.headers.get("Origin") || "";
  const contentType = (request.headers.get("Content-Type") || "").split(";", 1)[0].trim().toLowerCase();
  const isJson = contentType === "application/json";
  const respond = (data, status = 200) => isJson
    ? contactJson(data, status)
    : contactFormPage(data.error || `Bedankt. Je aanvraag ${data.reference} is ontvangen. Cohentra Support neemt per e-mail contact met je op.`, status);

  if (request.method === "OPTIONS") {
    const requestedHeaders = (request.headers.get("Access-Control-Request-Headers") || "").split(",").map((value) => value.trim().toLowerCase()).filter(Boolean);
    if (origin !== "https://cohentra.digital" || request.headers.get("Access-Control-Request-Method") !== "POST" || requestedHeaders.some((header) => header !== "content-type")) {
      return new Response(null, { status: 403 });
    }
    return new Response(null, { status: 204, headers: contactCorsHeaders() });
  }
  if (request.method !== "POST") return json({ error: "Niet gevonden." }, 404);
  if (origin !== "https://cohentra.digital") return isJson ? json({ error: "Aanvraag niet toegestaan." }, 403) : contactFormPage("Deze aanvraag is niet toegestaan.", 403);

  const nowMs = Date.now();
  const windowStartedAt = Math.floor(nowMs / (60 * 60 * 1000));
  const ipHash = await digest(request.headers.get("CF-Connecting-IP") || "unknown");
  await env.DB.batch([
    env.DB.prepare("DELETE FROM website_contact_rate_limits WHERE window_started_at < ?").bind(windowStartedAt - 24),
    env.DB.prepare("INSERT INTO website_contact_rate_limits (ip_hash, window_started_at, request_count) VALUES (?, ?, 1) ON CONFLICT(ip_hash, window_started_at) DO UPDATE SET request_count = request_count + 1").bind(ipHash, windowStartedAt)
  ]);
  const rateLimit = await env.DB.prepare("SELECT request_count FROM website_contact_rate_limits WHERE ip_hash = ? AND window_started_at = ?").bind(ipHash, windowStartedAt).first();
  if (Number(rateLimit?.request_count || 0) > 5) return respond({ error: "Je hebt veel aanvragen kort na elkaar verstuurd. Probeer het later opnieuw." }, 429);

  let body;
  try { body = await readContactBody(request); } catch (error) {
    const status = String(error?.message || "").includes("te groot") ? 413 : 400;
    return respond({ error: status === 413 ? "Je bericht is te groot." : "Vul het formulier opnieuw in en probeer het nog eens." }, status);
  }
  if (!body || typeof body !== "object" || Array.isArray(body)) return respond({ error: "Vul het formulier opnieuw in en probeer het nog eens." }, 400);
  if (String(body.company_site || "").trim()) {
    const reference = `CH-${new Date().getUTCFullYear()}-${randomHex(5).toUpperCase()}`;
    return respond({ ok: true, reference }, 201);
  }

  const name = String(body.name || "").trim();
  const email = String(body.email || "").trim();
  const organization = String(body.organization || "").trim();
  const requestType = String(body.request_type || "").trim();
  const subject = String(body.subject || "").trim();
  const message = String(body.message || "").trim();
  if (!name || name.length > 120 || !/^[^\s<>@]+@[^\s<>@]+\.[^\s<>@]+$/.test(email) || email.length > 254 || organization.length > 160 || !WEBSITE_REQUEST_TYPES[requestType] || !subject || subject.length > 120 || !message || message.length > 5000) {
    return respond({ error: "Controleer je naam, e-mailadres, onderwerp en bericht." }, 400);
  }

  const now = new Date().toISOString();
  const id = crypto.randomUUID();
  const reference = `CH-${new Date(now).getUTCFullYear()}-${randomHex(5).toUpperCase()}`;
  const ticketMessage = [
    `Bron: Websiteformulier`,
    `Type aanvraag: ${WEBSITE_REQUEST_TYPES[requestType]}`,
    `Bedrijf of organisatie: ${organization || "Niet opgegeven"}`,
    "",
    message
  ].join("\n");

  await env.DB.batch([
    env.DB.prepare("INSERT OR IGNORE INTO customers (id, name, contact_name, contact_email, notes, status, created_at, updated_at) VALUES (?, 'Websiteformulieraanvragen', '', '', 'Interne inbox voor websitecontacten.', 'paused', ?, ?)").bind(WEBSITE_CONTACT_CUSTOMER_ID, now, now),
    env.DB.prepare("INSERT INTO support_tickets (id, reference, customer_id, created_by_account_id, category, subject, message, status, assigned_to, created_at, updated_at, source, contact_name, contact_email, organization, request_type) VALUES (?, ?, ?, NULL, 'other', ?, ?, 'new', NULL, ?, ?, 'website', ?, ?, ?, ?)").bind(id, reference, WEBSITE_CONTACT_CUSTOMER_ID, subject, ticketMessage, now, now, name, email, organization, requestType)
  ]);

  const emailSent = await sendSupportTicketEmail(env, {
    reference,
    source: "website",
    customerName: name,
    contactEmail: email,
    category: `Websiteformulier · ${WEBSITE_REQUEST_TYPES[requestType]}`,
    subject,
    message: ticketMessage
  });
  return respond({ ok: true, reference, source: "website", email_sent: emailSent }, 201);
}

async function handle(request, env) {
  const url = new URL(request.url);
  if (request.method === "GET" && url.pathname === "/health") {
    await env.DB.prepare("SELECT 1 AS ok").first();
    return json({ status: "ok" });
  }
  if (url.pathname === "/api/public/contact" && url.hostname === "support.cohentra.digital") return await handlePublicContact(request, env);
  if (request.method === "GET" && (url.pathname === "/" || url.pathname === "/admin")) {
    const host = url.hostname.toLowerCase();
    if ((host === "customer.cohentra.digital" || host === "support.cohentra.digital") && url.pathname !== "/") return json({ error: "Niet gevonden." }, 404);
    const html = host === "customer.cohentra.digital" ? CUSTOMER_HTML : host === "support.cohentra.digital" ? SUPPORT_HTML : ADMIN_HTML;
    return new Response(html, { headers: {
      "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store",
      "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
      "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer"
    }});
  }
  if (request.method === "POST" && url.pathname === "/api/customer/auth/forgot-password") {
    let body; try { body = await readJson(request); } catch { return json({ error: "Ongeldige aanvraag." }, 400); }
