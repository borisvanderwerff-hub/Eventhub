    }
    if (request.method === "GET" && url.pathname === "/api/support/tickets") {
      const { results } = await env.DB.prepare("SELECT t.id, t.reference, t.category, t.subject, t.message, t.status, t.created_at, t.updated_at, t.assigned_to, t.source, t.organization, t.request_type, COALESCE(NULLIF(t.contact_name, ''), NULLIF(c.contact_name, ''), c.name) AS customer_name, COALESCE(NULLIF(t.contact_email, ''), c.contact_email) AS contact_email FROM support_tickets t JOIN customers c ON c.id = t.customer_id ORDER BY CASE t.status WHEN 'new' THEN 0 WHEN 'in_progress' THEN 1 WHEN 'waiting_customer' THEN 2 ELSE 3 END, t.updated_at DESC LIMIT 500").all();
      return json({ tickets: results });
    }
    const ticketRoute = /^\/api\/support\/tickets\/([0-9a-f-]{36})(?:\/(replies))?$/i.exec(url.pathname);
    if (ticketRoute && !ticketRoute[2] && request.method === "GET") {
      const ticket = await env.DB.prepare("SELECT t.id, t.reference, t.category, t.subject, t.message, t.status, t.created_at, t.updated_at, t.assigned_to, t.source, t.organization, t.request_type, COALESCE(NULLIF(t.contact_name, ''), NULLIF(c.contact_name, ''), c.name) AS customer_name, COALESCE(NULLIF(t.contact_email, ''), c.contact_email) AS contact_email FROM support_tickets t JOIN customers c ON c.id = t.customer_id WHERE t.id = ?").bind(ticketRoute[1]).first();
      if (!ticket) return json({ error: "Ticket niet gevonden." }, 404);
      const { results: replies } = await env.DB.prepare("SELECT id, author_name, author_email, message, delivery_status, created_at, sent_at FROM support_ticket_messages WHERE ticket_id = ? ORDER BY created_at ASC").bind(ticketRoute[1]).all();
      return json({ ticket, replies });
